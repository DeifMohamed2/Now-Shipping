  <!-- ========== TRUST ========== -->
  <section class="section trust">
    <div class="container">
      <span class="eyebrow">الثقة</span>
      <h2 class="section-title">ليه تثق في <span class="text-orange">Now</span> من اليوم الأول؟</h2>
      <div class="trust__grid">
        <article class="trust-card">
          <div class="trust-card__icon" aria-hidden="true"><i class="fa-solid fa-lock"></i></div>
          <div class="trust-card__body">
            <h3 class="trust-card__title">تأمين على كل شحنة</h3>
            <p class="trust-card__text">بضاعتك متغطية من الـ <span class="ltr">Pickup</span> لحد الـ <span class="ltr">Delivery</span>. في حالة فقدان أو تلف، التعويض يتم خلال أقل من 24 ساعة.</p>
          </div>
        </article>
        <article class="trust-card">
