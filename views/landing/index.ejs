    <div class="container">
      <span class="eyebrow">المقارنة</span>
      <h2 class="section-title comparison__title">
        قارن بين تجربة شحن تقليدية وتجربة استثنائية<br>
        الفرق بين <span class="text-orange"><span class="ltr">NOW</span></span> وشركات الشحن التقليدية
      </h2>

      <div class="compare-table">
        <div class="compare-table__header">
          <div class="compare-table__cell compare-table__cell--criteria-h">المعيار</div>
          <div class="compare-table__cell compare-table__cell--traditional-h">شركات الشحن التقليدية</div>
          <div class="compare-table__cell compare-table__cell--now-h">Now Shipping</div>
        </div>
        <div class="compare-table__row">
          <div class="compare-table__cell compare-table__cell--label"><span class="ltr">Same Day Delivery</span></div>
          <div class="compare-table__cell compare-table__cell--neg">محدود / مش متاح</div>
          <div class="compare-table__cell compare-table__cell--pos"><span class="compare-table__check">✓</span> متاح في القاهرة</div>
        </div>
        <div class="compare-table__row">
          <div class="compare-table__cell compare-table__cell--label">الكورييرز</div>
          <div class="compare-table__cell compare-table__cell--neg"><span class="ltr">3PL Aggregators</span></div>
          <div class="compare-table__cell compare-table__cell--pos"><span class="compare-table__check">✓</span> موظفين Now</div>
        </div>
        <div class="compare-table__row">
          <div class="compare-table__cell compare-table__cell--label"><span class="ltr">First-Attempt Delivery</span></div>
          <div class="compare-table__cell compare-table__cell--neg">متوسط منخفض</div>
          <div class="compare-table__cell compare-table__cell--pos"><span class="compare-table__check">✓</span> 98% نسبة نجاح</div>
        </div>
        <div class="compare-table__row">
          <div class="compare-table__cell compare-table__cell--label">التكامل مع المتجر</div>
