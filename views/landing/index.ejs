<%- contentFor('HeaderCss') %>
<meta name="description" content="ارفع أرباحك ونسب تسليماتك مع Now Shipping — Same Day Delivery، Dashboard، وتكامل مع Shopify و WooCommerce و Salla">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/assets/rCSS/landing.css?v=<%= assetVersion %>">

<%- contentFor('body') %>
<%- include('../partials/landing-nav', { page: 'landing' }) %>

  <!-- ========== HERO ========== -->
  <section class="hero" id="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <span class="hero__chip">
          <span class="hero__chip-dot" aria-hidden="true"></span>
          <span class="hero__chip-text">الشريك اللوجستي المتخصص لـ <span class="ltr">E-commerce</span> في القاهرة</span>
        </span>
        <h1 class="hero__title">
          <span class="hero__title-line">ارفع أرباحك ونسب</span>
          <span class="hero__title-line">تسليماتك <span class="text-orange">مع Now</span></span>
        </h1>
        <p class="hero__desc">
          وصل شحنة عميلك في نفس يوم الطلب.<br>
          ارفع معدل تسليم الاوردات الي 98%<br>
          تابع كل أورداتك من <span class="ltr">Dashboard</span> واحد<br>
          قلّل مشاكل التسليم من خلال فريق مناديب محترف من NOW.
        </p>
        <a href="#register" class="btn btn--orange btn--lg hero__cta">
          ابدأ خطة شحن مناسبة لبيزنسك مع NOW
          <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        </a>
        <div class="hero__checks">
          <p class="hero__checks-line">
            <span class="hero__check-group">
              <i class="fa-solid fa-check hero__check-icon" aria-hidden="true"></i>
              <span> داخل القاهرة و الجيزة </span>
            </span>
            <span class="hero__check-item hero__check-item--ltr">
              <span class="ltr">Same Day Delivery</span>
              <i class="fa-solid fa-check hero__check-icon" aria-hidden="true"></i>
            </span>
          </p>
          <p class="hero__checks-line">
            <span class="hero__check-item hero__check-item--ltr">
              <span class="ltr">Shopify / WooCommerce </span>
              <i class="fa-solid fa-check hero__check-icon" aria-hidden="true"></i>
            </span>
          </p>
        </div>
      </div>

      <div class="hero__visual">
        <div class="dash-preview">
          <span class="dash-preview__badge">Dashboard Preview</span>
          <div class="dash-preview__topbar">
            <div class="dash-preview__dots" aria-hidden="true">
              <span class="dash-preview__dot dash-preview__dot--green"></span>
              <span class="dash-preview__dot dash-preview__dot--yellow"></span>
              <span class="dash-preview__dot dash-preview__dot--red"></span>
            </div>
          </div>
          <div class="dash-preview__stats">
            <div class="dash-preview__stat">
              <span class="dash-preview__stat-label">Wallet</span>
              <span class="dash-preview__stat-value">42K</span>
              <span class="dash-preview__stat-meta">جنيه</span>
            </div>
            <div class="dash-preview__stat">
              <span class="dash-preview__stat-label">نسبة التسليم</span>
              <span class="dash-preview__stat-value">98%</span>
              <span class="dash-preview__stat-meta">3% <span aria-hidden="true">▲</span></span>
            </div>
            <div class="dash-preview__stat">
              <span class="dash-preview__stat-label">أوردرات اليوم</span>
              <span class="dash-preview__stat-value">247</span>
              <span class="dash-preview__stat-meta">12% <span aria-hidden="true">▲</span></span>
            </div>
          </div>
          <div class="dash-preview__chart">
            <div class="dash-preview__chart-head">
              <span class="dash-preview__chart-title">Deliveries</span>
              <span class="dash-preview__chart-sep" aria-hidden="true">—</span>
              <span class="dash-preview__chart-sub">آخر 7 أيام</span>
            </div>
            <div class="bar-chart" id="barChart" aria-hidden="true">
              <div class="bar-chart__bar" data-height="88"></div>
              <div class="bar-chart__bar" data-height="80"></div>
              <div class="bar-chart__bar" data-height="70"></div>
              <div class="bar-chart__bar" data-height="40"></div>
              <div class="bar-chart__bar" data-height="65"></div>
              <div class="bar-chart__bar" data-height="52"></div>
              <div class="bar-chart__bar" data-height="42"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PROBLEMS ========== -->
  <section class="section problems" id="about">
    <div class="container">
      <div class="problems__header">
        <span class="eyebrow">تحديات بتواجهها يوميا</span>
        <h2 class="section-title problems__title">
          لو بتدير <span class="ltr">ecommerce business</span> في القاهرة
        </h2>
 
      </div>

      <div class="problems__grid">
        <article class="problem-card">
          <span class="problem-card__num" aria-hidden="true">01</span>
          <div class="problem-card__content">
            <h3 class="problem-card__title">شحنت 100 أوردر، رجعلك 30!</h3>
            <p class="problem-card__text">
              30 ضعف شحن.<br>
              30 قطعة متعطلة في <span class="ltr">return cycle</span>.<br>
              و30 تجربة عميل خرجت بشكل مش مناسب للبراند.<br>
              لأن الكوريير غير مدرب ملتزمش بالـ <span class="ltr">pre-call</span>، ووصل في توقيت غير مناسب.<br>
              وفي الآخر، تكلفة الخطأ بترجع عليك كبراند.
            </p>
          </div>
        </article>
        <article class="problem-card">
          <span class="problem-card__num" aria-hidden="true">02</span>
          <div class="problem-card__content">
            <h3 class="problem-card__title">عميلك طلب الساعة 11، ومستني الأوردر في نفس اليوم؟</h3>
            <p class="problem-card__text">
              العميل النهارده بيدور على السرعة بنفس قدر اهتمامه بالمنتج.<br>
              فلو التسليم هيكون بكرة، فيه فرصة كبيرة يشتري من حد يقدر يوصّل النهارده.<br>
              وكل تأخير بسيط... ممكن يكلّفك عملية بيع.
            </p>
          </div>
        </article>
        <article class="problem-card">
          <span class="problem-card__num" aria-hidden="true">03</span>
          <div class="problem-card__content">
            <h3 class="problem-card__title">اللي بيمثّل براندك قدام العميل... خارج سيطرتك؟</h3>
            <p class="problem-card__text">
              كل يوم عميلك بيتعامل مع شخص مختلف في توصيل الاوردر. بدون <span class="ltr">Uniform</span> بدون أسلوب موحّد وبدون تجربة تمثّل البراند بالشكل الصح.<br>
              وفي لحظة التسليم، البراند بيتقيّم من شخص خارج سيطرتك.
            </p>
          </div>
        </article>
        <article class="problem-card">
          <span class="problem-card__num" aria-hidden="true">04</span>
          <div class="problem-card__content">
            <h3 class="problem-card__title">بتدير شحناتك على <span class="ltr">Excel</span> و <span class="ltr">WhatsApp</span></h3>
            <p class="problem-card__text">
              كل متابعة بتتم يدوي و كل سؤال محتاج رد وكل شحنة محتاجة ترجع تدوّر عليها.<br>
              مفيش <span class="ltr">Dashboard</span> يجمع الصورة ومفيش <span class="ltr">Data</span> واضحة تساعدك تدير الشحن بشكل أذكى.<br>
              وفي الآخر، البيزنس بيتم إدارته بالتخمين بدل الأرقام.
            </p>
          </div>
        </article>
      </div>

      <div class="quote-banner quote-banner--problems">
        <span class="quote-banner__glyph" aria-hidden="true">&ldquo;</span>
        <h3 class="quote-banner__title quote-banner__title--orange"><span class="ltr">NOW</span> لسه في مرحلة الإطلاق... وده جزء من الخطة.</h3>
        <p class="quote-banner__text">
          بدأنا بالقاهرة وبعدد محدود من المتاجر علشان نقدر نتحكم في كل خطوة من تجربة الشحن قبل التوسع.<br>
          من الاستلام، للتتبع، للتوزيع، لحد التسليم... كل مرحلة بتتبني وتنقاس على نطاق واضح.
        </p>
      </div>

      <div class="problems__cta">
        <a href="#solution" class="btn btn--navy btn--pill">
اطلب خطة شحن لبيزنسك
          <i class="fa-solid fa-arrow-down"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== SOLUTION ========== -->
  <section class="section solution" id="solution">
    <div class="container">
      <article class="solution-card">
        <span class="solution-card__eyebrow">الحل</span>
        <h2 class="solution-card__title">
          <span class="solution-card__title-navy"><span class="ltr">NOW</span> مش مجرد شركة شحن.</span><br>
          <span class="solution-card__title-orange"><span class="ltr">NOW</span> نظام تشغيل لإدارة شحنات الـ <span class="ltr">Ecommerce</span> في القاهرة.</span>
        </h2>
        <p class="solution-card__desc">
          اخترنا نبدأ بالقاهرة علشان نبني تجربة شحن نقدر نتحكم في تفاصيلها قبل التوسع. من لحظة تأكيد الأوردر، الشحنة بتدخل مسار واضح: <span class="ltr">Pickup</span> من مخزنك، توصيل من خلال فريق مناديب محترف من <span class="ltr">NOW</span>، <span class="ltr">Tracking</span> لحظي للعميل، <span class="ltr">Same Day Delivery</span> داخل النطاقات المتاحة، وإدارة كاملة من <span class="ltr">Dashboard</span> واحد. مع تأمين على الشحنات، وأسعار واضحة من البداية.
        </p>
      </article>
    </div>
  </section>

  <!-- ========== FEATURES ========== -->
  <section class="section features" id="features">
    <div class="container">
      <div class="features__header">
        <span class="eyebrow">المميزات</span>
        <h2 class="section-title">ليه <span class="text-orange">Now</span> تحديداً؟</h2>
        <p class="section-sub">6 أسباب تخلي إدارة الشحن أوضح، أسرع، وأكثر استقرارًا لبراندات الـ <span class="ltr">Ecommerce</span> في القاهرة مع <span class="text-orange">Now</span>.</p>
      </div>

      <div class="features__grid features__grid--large">
        <!-- Top-right (RTL col 1) -->
        <article class="feature-card feature-card--large">
          <div class="feature-card__head">
            <div class="feature-card__icon-tab" aria-hidden="true">
              <i class="fa-solid fa-truck-fast"></i>
            </div>
          </div>
          <div class="feature-card__body">
            <h3 class="feature-card__title"><span class="ltr">Same Day Delivery</span> حقيقي</h3>
            <p class="feature-card__text">Pickup قبل 12 ظهراً = تسليم نفس اليوم قبل 9 مساءً. مش &ldquo;نحاول&rdquo;. ده commitment موثق على كل أوردر داخل النطاق.</p>
            <span class="feature-card__chip"><span class="ltr">Commitment: قبل 9 مساءً</span></span>
          </div>
        </article>
        <!-- Top-left (RTL col 2) -->
        <article class="feature-card feature-card--large">
          <div class="feature-card__head">
            <div class="feature-card__icon-tab" aria-hidden="true">
              <i class="fa-solid fa-user-group"></i>
            </div>
          </div>
          <div class="feature-card__body">
            <h3 class="feature-card__title">كورييرز Now موظفين Now</h3>
            <p class="feature-card__text">كل كوريير بدوام كامل، uniform، و +40 ساعة تدريب على بروتوكول التواصل والتسليم. مش aggregator، مش freelancers.</p>
            <span class="feature-card__chip">+40 ساعة تدريب</span>
          </div>
        </article>
        <!-- Bottom-right (RTL col 1) -->
        <article class="feature-card feature-card--large">
          <div class="feature-card__head">
            <div class="feature-card__icon-tab" aria-hidden="true">
              <i class="fa-solid fa-bullseye"></i>
            </div>
          </div>
          <div class="feature-card__body">
            <h3 class="feature-card__title">98% نسبة تسليم من أول محاولة</h3>
            <p class="feature-card__text">اتصال مسبق بالعميل، توقيت دقيق، كوريير متدرب = أقل failed deliveries، أقل returns، أرباح أعلى من نفس الـ inventory.</p>
            <span class="feature-card__chip"><span class="ltr">Success Rate 98%</span></span>
          </div>
        </article>
        <!-- Bottom-left (RTL col 2) -->
        <article class="feature-card feature-card--large">
          <div class="feature-card__head">
            <div class="feature-card__icon-tab" aria-hidden="true">
              <i class="fa-solid fa-chart-line"></i>
            </div>
          </div>
          <div class="feature-card__body">
            <h3 class="feature-card__title">Dashboard بيدير شغلك</h3>
            <p class="feature-card__text"><span class="ltr">12+ metric live:</span> أوردرات، deliveries، returns، earnings، performance per courier، forecasting. بزنسك بيتحرك بـ data مش بـ guessing.</p>
            <span class="feature-card__chip"><span class="ltr">Live Metrics +12</span></span>
          </div>
        </article>
      </div>

      <div class="features__grid features__grid--compact">
        <!-- Bottom-right (RTL col 1) -->
        <article class="feature-card feature-card--compact">
          <div class="feature-card__icon-square" aria-hidden="true">
            <i class="fa-solid fa-plug-circle-check"></i>
          </div>
          <div class="feature-card__compact-body">
            <h3 class="feature-card__title"><span class="ltr">Native Integration</span></h3>
            <p class="feature-card__text">Sync مع <span class="ltr">Salla / Zid / WooCommerce / Shopify</span> في أقل من 10 دقايق. كل أوردر بيدخل Now أوتوماتيك.</p>
          </div>
        </article>
        <!-- Bottom-left (RTL col 2) -->
        <article class="feature-card feature-card--compact">
          <div class="feature-card__icon-square" aria-hidden="true">
            <i class="fa-solid fa-mobile-screen"></i>
          </div>
          <div class="feature-card__compact-body">
            <h3 class="feature-card__title"><span class="ltr">Mobile App</span> لـ Business</h3>
            <p class="feature-card__text"><span class="ltr">Approve، track، withdraw، contact courier.</span> <span class="ltr">Android + iOS</span> — كله من تليفونك.</p>
          </div>
        </article>
      </div>

      <div class="cta-center features__cta">
        <a href="#register" class="btn btn--orange btn--pill btn--lg">
          اطلب خطة شحن تناسب بيزنسك
          <i class="fa-solid fa-arrow-left"></i>
        </a>
      </div>
  </section>

  <!-- ========== STEPS ========== -->
  <section class="section steps" id="steps">
    <div class="container">
      <div class="steps__header">
        <span class="eyebrow eyebrow--light">إزاي تبدأ</span>
        <h2 class="section-title section-title--light">ابدأ في 4 خطوات (وأقل من يوم)</h2>
      </div>
      <div class="steps__grid">
        <div class="step">
          <div class="step__circle">1</div>
          <h3 class="step__title">سجل بياناتك</h3>
          <p class="step__text">أدخل بيانات بزنسك في أقل من 3 دقايق</p>
        </div>
        <div class="step">
          <div class="step__circle">2</div>
          <h3 class="step__title">اربط متجرك</h3>
          <p class="step__text"><span class="ltr">Native integration</span> أو ارفع أوردراتك يدوي</p>
        </div>
        <div class="step">
          <div class="step__circle">3</div>
          <h3 class="step__title">كوريير Now بيستلم</h3>
          <p class="step__text">Pickup من مخزنك في الوقت اللي بتحدده</p>
        </div>
        <div class="step">
          <div class="step__circle">4</div>
          <h3 class="step__title">تابع التسليم لحظياً</h3>
          <p class="step__text"><span class="ltr">Real-time tracking</span> لحد ما توصل لعميلك</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== COMPARISON ========== -->
