<%- contentFor('HeaderCss') %>
<meta name="description" content="Track your Now Shipping order — live status and delivery history">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/assets/rCSS/landing.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/assets/rCSS/tracking.css">

<%- contentFor('body') %>
<div class="track-page">
  <%- include('../partials/landing-nav', { page: 'tracking' }) %>

  <% 
    const T = translation.pages && translation.pages.tracking ? translation.pages.tracking : {};
    const isAr = typeof currentLang !== 'undefined' && currentLang === 'ar';
    const stepLabels = [
      (T.stepPlaced || 'Placed'),
      (T.stepPickedUp || 'Picked up'),
      (T.stepProcessing || 'Processing'),
      (T.stepOut || 'Out for delivery'),
      (T.stepDone || 'Delivered')
    ];
    function trackingStepIndex(status) {
      var s = (status || '').toString();
      if (['completed','returnCompleted'].indexOf(s) !== -1) return 6;
      if (['headingToCustomer','headingToYou'].indexOf(s) !== -1) return 4;
      if (['inProgress','waitingAction','rescheduled','inReturnStock'].indexOf(s) !== -1) return 3;
      if (['pickedUp','inStock'].indexOf(s) !== -1) return 2;
      if (['new','pendingPickup'].indexOf(s) !== -1) return 1;
      return 2;
    }
    function isReturnFlow(status) {
      var s = status || '';
      return ['returnInitiated','returnAssigned','returnPickedUp','returnAtWarehouse','returnToBusiness','returnToWarehouse','returned','exchangePickup','returnLinked','autoReturnInitiated','inReturnStock'].indexOf(s) !== -1;
    }
    const od = typeof orderData !== 'undefined' ? orderData : null;
    const terr = typeof trackingError !== 'undefined' ? trackingError : null;
    const searched = typeof searchedNumber !== 'undefined' ? searchedNumber : '';
  %>

  <main class="track-page__main">

    <% if (!od) { %>
    <section class="track-search-hero">
      <div class="track-search-hero__decor" aria-hidden="true">
        <span class="track-decor track-decor--1"></span>
        <span class="track-decor track-decor--2"></span>
        <span class="track-decor track-decor--3"></span>
        <span class="track-decor track-decor--4"></span>
      </div>
      <div class="track-search-hero__inner">
        <div class="track-search-hero__icon-wrap">
          <span class="track-search-hero__icon-ring"></span>
          <div class="track-search-hero__icon" aria-hidden="true">
            <i class="fa-solid fa-location-dot"></i>
          </div>
        </div>
        <span class="track-search-hero__eyebrow">
          <i class="fa-solid fa-truck-fast"></i>
          <%= isAr ? 'تتبع الشحنة' : 'Track shipment' %>
        </span>
        <h1 class="track-search-hero__title"><%= T.title || (isAr ? 'تابع شحنتك لحظياً' : 'Track your shipment') %></h1>
        <p class="track-search-hero__desc"><%= (T.subtitle || (isAr ? 'أدخل رقم الأوردر أو الباركود لمتابعة الحالة والتاريخ الكامل للتوصيل.' : 'Enter your order or flyer number for live status and history.')).replace(/^\.\s*/, '') %></p>

        <div class="track-search-card">
          <form class="track-search-form" method="get" action="/tracking" role="search" aria-label="<%= T.title || 'Track order' %>">
            <div class="track-search-bar">
              <input type="text" id="trackQuery" name="q" value="<%= searched || '' %>" placeholder="<%= T.trackingPlaceholder || (isAr ? 'رقم الأوردر أو الباركود' : 'Order or barcode number') %>" autocomplete="off" maxlength="64" autofocus />
              <button type="submit" class="btn btn--orange">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <%= T.track || (isAr ? 'تتبع' : 'Track') %>
              </button>
            </div>
            <p class="track-search-form__hint">
              <i class="fa-solid fa-circle-info"></i>
              <%= isAr ? 'مثال: ORD-12345 أو الباركود المطبوع على بوليصة الشحن' : 'Example: ORD-12345 or the barcode on your shipping label' %>
            </p>
          </form>

          <% if (terr === 'not_found' && searched) { %>
            <div class="track-alert track-alert--err" role="alert">
              <i class="fa-solid fa-circle-exclamation"></i>
              <span><%= T.notFound || (isAr ? 'لم يتم العثور على شحنة بهذا الرقم. تحقق من الكود وحاول مرة أخرى.' : 'No shipment found for this number. Check the code and try again.') %></span>
            </div>
          <% } else if (terr === 'server') { %>
            <div class="track-alert track-alert--err" role="alert">
              <i class="fa-solid fa-server"></i>
              <span><%= T.serverError || (isAr ? 'حدث خطأ. يرجى المحاولة مرة أخرى.' : 'Something went wrong. Please try again shortly.') %></span>
            </div>
          <% } %>

          <div class="track-search-hints">
            <div class="track-hint">
              <span class="track-hint__icon"><i class="fa-solid fa-bolt"></i></span>
              <span><%= isAr ? 'تحديثات لحظية' : 'Live updates' %></span>
            </div>
            <div class="track-hint">
              <span class="track-hint__icon"><i class="fa-solid fa-clock-rotate-left"></i></span>
              <span><%= isAr ? 'تاريخ كامل للشحنة' : 'Full shipment history' %></span>
            </div>
            <div class="track-hint">
              <span class="track-hint__icon"><i class="fa-solid fa-share-nodes"></i></span>
              <span><%= isAr ? 'مشاركة الرابط بسهولة' : 'Easy link sharing' %></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <% } else { %>
    <section class="track-results-hero" aria-label="<%= T.title || 'Tracking' %>">
      <div class="track-results-hero__inner">
        <div>
          <p class="track-results-hero__label"><%= T.trackingNumber || (isAr ? 'رقم المرجع' : 'Reference') %></p>
          <h1 class="track-results-hero__title"><%= od.orderNumber %></h1>
          <p class="track-results-hero__sub"><%= T.resultsSubtitle || (isAr ? 'حالة الشحنة وتفاصيل التوصيل لحظياً.' : 'Live status and delivery details for this shipment.') %></p>
        </div>
        <a href="/tracking" class="btn btn--ghost">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <%= T.trackAnother || (isAr ? 'تتبع شحنة أخرى' : 'Track another shipment') %>
        </a>
      </div>
    </section>

    <% 
      const idx = trackingStepIndex(od.orderStatus);
      const returnFlow = isReturnFlow(od.orderStatus);
      const shareUrl = typeof trackingShareUrl !== 'undefined' && trackingShareUrl ? trackingShareUrl : ('/t/' + encodeURIComponent(od.orderNumber));
    %>
    <div class="track-dashboard">
      <article class="track-card">
        <div class="track-card__accent" aria-hidden="true"></div>
        <div class="track-card__body">
          <h2 class="track-card__heading">
            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
            <%= T.cardOverview || (isAr ? 'نظرة عامة' : 'Shipment overview') %>
          </h2>

          <div class="track-status-row">
            <div>
              <div class="track-results-hero__label" style="color:var(--text-muted);text-transform:uppercase;"><%= T.status || (isAr ? 'الحالة' : 'Status') %></div>
              <p class="track-status-row__ref"><%= od.orderNumber %></p>
              <% if (od.businessName) { %><p class="track-status-row__biz"><%= od.businessName %></p><% } %>
            </div>
            <div>
              <% if (returnFlow && !['completed','returnCompleted'].includes(od.orderStatus)) { %>
                <span class="track-badge track-badge--return"><i class="fa-solid fa-rotate-left"></i> <%= T.returnFlow || (isAr ? 'مرتجع' : 'Return flow') %></span>
              <% } else if (['completed','returnCompleted'].includes(od.orderStatus)) { %>
                <span class="track-badge track-badge--done"><i class="fa-solid fa-circle-check"></i> <%= T.completed || (isAr ? 'مكتمل' : 'Completed') %></span>
              <% } else if (['canceled','rejected','terminated','deliveryFailed'].includes(od.orderStatus)) { %>
                <span class="track-badge track-badge--bad"><i class="fa-solid fa-circle-xmark"></i> <%= od.orderStatus %></span>
              <% } else { %>
                <span class="track-badge"><i class="fa-solid fa-truck-fast"></i> <%= od.orderStatus %></span>
              <% } %>
            </div>
          </div>

          <% if (!returnFlow || ['completed','returnCompleted','headingToCustomer','pickedUp','new','pendingPickup','inStock','inProgress'].includes(od.orderStatus)) { %>
          <div class="track-steps" aria-hidden="true">
            <% for (var ti = 0; ti < 5; ti++) {
              var stepNum = ti + 1;
              var allDone = idx === 6;
              var done = allDone || stepNum < idx;
              var active = !allDone && stepNum === idx;
              var cls = done ? 'track-step track-step--done' : active ? 'track-step track-step--active' : 'track-step';
            %>
            <div class="<%= cls %>">
              <div class="track-step__dot"><% if (done) { %><i class="fa-solid fa-check"></i><% } else { %><%= stepNum %><% } %></div>
              <span><%= stepLabels[ti] %></span>
            </div>
            <% } %>
          </div>
          <% } %>

          <dl class="track-details">
            <div class="track-kv"><dt><%= T.trackingNumber || (isAr ? 'المرجع' : 'Reference') %></dt><dd><%= od.orderNumber %></dd></div>
            <% if (od.smartFlyerBarcode) { %><div class="track-kv"><dt><%= T.barcode || (isAr ? 'الباركود' : 'Barcode') %></dt><dd><%= od.smartFlyerBarcode %></dd></div><% } %>
            <div class="track-kv"><dt><%= T.orderType || (isAr ? 'النوع' : 'Type') %></dt><dd><%= od.orderShipping.orderType %></dd></div>
            <div class="track-kv"><dt><%= T.codAmount || (isAr ? 'المبلغ' : 'Amount') %></dt><dd><%= od.orderShipping.amountType || '—' %> · <%= od.orderShipping.amount != null ? od.orderShipping.amount : '—' %></dd></div>
            <div class="track-kv"><dt><%= T.estimatedDelivery || (isAr ? 'القطع' : 'Items') %></dt><dd><%= od.orderShipping.numberOfItems != null ? od.orderShipping.numberOfItems : '—' %> · <%= od.orderShipping.isExpressShipping ? 'Express' : 'Standard' %></dd></div>
            <div class="track-kv"><dt><%= T.location || (isAr ? 'المنطقة' : 'Area') %></dt><dd><%= [od.orderCustomer.zone, od.orderCustomer.government].filter(Boolean).join(' · ') || '—' %></dd></div>
          </dl>

          <% if (od.orderShipping.productDescription) { %>
            <p class="track-note"><strong><%= T.shipmentDetails || (isAr ? 'تفاصيل الشحنة' : 'Shipment details') %>:</strong> <%= od.orderShipping.productDescription %></p>
          <% } %>

          <% if (od.deliveryMan) { %>
          <div class="track-courier">
            <strong><i class="fa-solid fa-motorcycle" aria-hidden="true"></i> <%= T.courier || (isAr ? 'الكوريير' : 'Your courier') %></strong>
            <p><%= od.deliveryMan.name %></p>
            <% if (od.deliveryMan.phoneNumber) { %>
              <p><a href="tel:<%= od.deliveryMan.phoneNumber %>"><%= od.deliveryMan.phoneNumber %></a></p>
            <% } %>
          </div>
          <% } %>

          <div class="track-share">
            <span class="track-share__label"><%= T.share || (isAr ? 'مشاركة' : 'Share') %>:</span>
            <button type="button" class="track-share__btn" id="copyTrackLink" data-url="<%= shareUrl %>" data-copied="<%= isAr ? 'تم النسخ' : 'Copied' %>">
              <i class="fa-solid fa-link"></i> <%= isAr ? 'نسخ الرابط' : 'Copy link' %>
            </button>
            <a class="track-share__wa" href="https://wa.me/?text=<%= encodeURIComponent((T.waPrefix || (isAr ? 'تتبع طلبي:' : 'Track my order:')) + ' ' + shareUrl) %>" target="_blank" rel="noopener">
              <i class="fa-brands fa-whatsapp"></i> WhatsApp
            </a>
          </div>
        </div>
      </article>

      <article class="track-card">
        <div class="track-card__accent" aria-hidden="true"></div>
        <div class="track-card__body" style="display:flex;flex-direction:column;min-height:320px;">
          <h2 class="track-card__heading">
            <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
            <%= T.history || (isAr ? 'سجل الحالات' : 'Status history') %>
          </h2>

          <div class="track-timeline-scroll">
            <% if (od.orderStatusHistory && od.orderStatusHistory.length) { %>
            <ul class="track-timeline">
              <% od.orderStatusHistory.forEach(function (h) { %>
              <li>
                <div class="track-timeline__icon"><i class="fa-solid fa-circle" style="font-size:0.4rem;"></i></div>
                <div>
                  <strong><%= h.status %></strong>
                  <% if (h.notes) { %><div class="track-timeline__notes"><%= h.notes %></div><% } %>
                  <div class="track-timeline__meta"><%= h.date ? new Date(h.date).toLocaleString() : '' %><% if (h.category) { %> · <%= h.category %><% } %></div>
                </div>
              </li>
              <% }); %>
            </ul>
            <% } else { %>
              <p class="track-empty"><%= T.noHistory || (isAr ? 'لا يوجد سجل تفصيلي بعد.' : 'No detailed history yet.') %></p>
            <% } %>
          </div>
        </div>
      </article>
    </div>
    <% } %>

  </main>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/rJS/landing.js?v=<%= assetVersion %>"></script>
<script>
(function () {
  var btn = document.getElementById('copyTrackLink');
  if (!btn) return;
  var copiedLabel = btn.getAttribute('data-copied') || 'Copied';
  var defaultHtml = btn.innerHTML;
  btn.addEventListener('click', function () {
    var u = btn.getAttribute('data-url');
    if (!u) return;
    var full = u.indexOf('http') === 0 ? u : (window.location.origin + u);
    function done() {
      btn.innerHTML = '<i class="fa-solid fa-check"></i> ' + copiedLabel;
      setTimeout(function () { btn.innerHTML = defaultHtml; }, 2000);
    }
    if (navigator.clipboard) {
      navigator.clipboard.writeText(full).then(done).catch(tryFallback);
    } else {
      tryFallback();
    }
    function tryFallback() {
      var ta = document.createElement('textarea');
      ta.value = full;
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch (e) {}
      document.body.removeChild(ta);
    }
  });
})();
</script>
