<%- contentFor('HeaderCss') %>
<meta name="description" content="Now Shipping Privacy Policy — data collection, use, sharing, and your rights for our Business and Courier mobile apps.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700&family=Inter:wght@400;500;600;700&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/assets/rCSS/landing.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/assets/rCSS/privacy-policy.css">

<%- contentFor('body') %>
<div class="legal-page legal-page--en">
  <%- include('../partials/landing-nav', { page: 'privacy' }) %>

  <% 
    const T = typeof privacyPolicyData !== 'undefined' && privacyPolicyData
      ? privacyPolicyData
      : (translation.pages && translation.pages.privacyPolicy ? translation.pages.privacyPolicy : {});
    const sections = Array.isArray(T.sections) ? T.sections : [];
    const contact = T.contact || {};
    const contactEmail = contact.email || (typeof siteContactEmail !== 'undefined' ? siteContactEmail : 'info@now.com.eg');
    const contactPhone = contact.phone || (typeof sitePublicPhone !== 'undefined' ? sitePublicPhone : '+201119177677');
    const contactAddress = contact.address || (typeof sitePhysicalAddress !== 'undefined' ? sitePhysicalAddress : 'Cairo, Egypt');
    const isArSiteLang = typeof currentLang !== 'undefined' && currentLang === 'ar';
  %>

  <main class="legal-page__main">
    <section class="legal-hero">
      <div class="legal-hero__inner">
        <span class="legal-hero__eyebrow">
          <i class="fa-solid fa-shield-halved"></i>
          Privacy &amp; Data Protection
        </span>
        <h1 class="legal-hero__title"><%= T.title || 'Privacy Policy' %></h1>
        <p class="legal-hero__desc"><%= T.subtitle || '' %></p>
        <% if (T.appsCovered) { %>
        <p class="legal-hero__apps"><%= T.appsCovered %></p>
        <% } %>
        <div class="legal-hero__dates">
          <% if (T.effectiveDate) { %><span><%= T.effectiveDate %></span><% } %>
          <% if (T.lastUpdated) { %><span><%= T.lastUpdated %></span><% } %>
        </div>
        <% if (isArSiteLang && T.englishOnlyNotice) { %>
        <p class="legal-hero__notice"><i class="fa-solid fa-circle-info"></i> <%= T.englishOnlyNotice %></p>
        <% } %>
      </div>
    </section>

    <div class="legal-layout">
      <% if (sections.length) { %>
      <aside class="legal-toc" aria-label="<%= T.tocTitle || 'Table of Contents' %>">
        <div class="legal-toc__inner">
          <h2 class="legal-toc__title"><%= T.tocTitle || 'Table of Contents' %></h2>
          <ol class="legal-toc__list">
            <% sections.forEach(function (section) { %>
            <li><a href="#<%= section.id %>"><%= section.title %></a></li>
            <% }); %>
            <% if (contact.title) { %>
            <li><a href="#contact-us"><%= contact.title %></a></li>
            <% } %>
          </ol>
        </div>
      </aside>
      <% } %>

      <div class="legal-content">
        <div class="legal-content__inner">
          <% sections.forEach(function (section) { %>
          <section id="<%= section.id %>" class="legal-section">
            <h2 class="legal-section__title"><%= section.title %></h2>
            <% if (section.paragraphs && section.paragraphs.length) {
              section.paragraphs.forEach(function (para) { %>
            <p><%= para %></p>
            <% }); } %>
            <% if (section.list && section.list.length) { %>
            <ul class="legal-section__list">
              <% section.list.forEach(function (item) { %>
              <li><%= item %></li>
              <% }); %>
            </ul>
            <% } %>
          </section>
          <% }); %>

          <% if (contact.title) { %>
          <section id="contact-us" class="legal-section legal-section--contact">
            <h2 class="legal-section__title"><%= contact.title %></h2>
            <% if (contact.text) { %><p><%= contact.text %></p><% } %>
            <ul class="legal-contact-list">
              <li>
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                <a href="mailto:<%= contactEmail %>"><%= contactEmail %></a>
              </li>
              <li>
                <i class="fa-solid fa-phone" aria-hidden="true"></i>
                <a href="tel:<%= contactPhone.replace(/\s/g, '') %>"><%= contactPhone %></a>
              </li>
              <li>
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                <span><%= contactAddress %></span>
              </li>
            </ul>
          </section>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p>Now Shipping. All rights reserved. — <a href="mailto:<%= contactEmail %>"><%= contactEmail %></a> 2026 ©</p>
    </div>
  </footer>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/rJS/landing.js?v=<%= assetVersion %>"></script>
<script>
(function () {
  var tocLinks = document.querySelectorAll('.legal-toc__list a[href^="#"]');
  if (!tocLinks.length) return;

  function setActive(id) {
    tocLinks.forEach(function (link) {
      link.classList.toggle('is-active', link.getAttribute('href') === '#' + id);
    });
  }

  var sections = [];
  tocLinks.forEach(function (link) {
    var id = (link.getAttribute('href') || '').replace('#', '');
    var el = id ? document.getElementById(id) : null;
    if (el) sections.push({ id: id, el: el });
  });

  function onScroll() {
    var scrollY = window.scrollY || window.pageYOffset;
    var current = sections[0] && sections[0].id;
    for (var i = sections.length - 1; i >= 0; i--) {
      if (scrollY >= sections[i].el.offsetTop - 120) {
        current = sections[i].id;
        break;
      }
    }
    if (current) setActive(current);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();
</script>
