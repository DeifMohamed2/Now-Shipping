<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-theme="default">

<head>

  <meta charset="utf-8" />
  <% if (typeof documentTitle !== 'undefined' && documentTitle) { %>
  <title><%= documentTitle %></title>
  <% } else { %>
  <title> <%-title%> | Now Shipping</title>
  <% } %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<% if (typeof publicSeo !== 'undefined' && publicSeo && publicSeo.ogDescription) { %>
<meta content="<%= publicSeo.ogDescription %>" name="description" />
<% } else { %>
<meta content="Professional shipping services - fast and reliable delivery for your cargo." name="description" />
<% } %>
<meta content="Now Shipping" name="author" />
<% if (typeof publicSeo !== 'undefined' && publicSeo) { %>
<link rel="canonical" href="<%= publicSeo.canonicalUrl %>" />
<meta property="og:url" content="<%= publicSeo.ogUrl %>" />
<meta property="og:type" content="<%= publicSeo.ogType || 'website' %>" />
<meta property="og:title" content="<%= publicSeo.ogTitle %>" />
<meta property="og:description" content="<%= publicSeo.ogDescription %>" />
<meta property="og:image" content="<%= publicSeo.ogImage %>" />
<% } %>

  <!-- App favicon -->

    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

   <link rel="shortcut icon" href="/assets/rImages/mainlogospining.png">
  <%- typeof HeaderCss !== 'undefined' ? HeaderCss : '' %>

  <%- include ('../partials/head-css.ejs') %>

</head>

<body>

  <%- body%>

  <%- include ('../partials/vendor-scripts') %>
  <%- typeof FooterJs !== 'undefined' ? FooterJs : '' %>

</body>

</html>