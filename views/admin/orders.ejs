<%- contentFor('HeaderCss') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.7.6/lottie.min.js"></script>

<link href="/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/flatpickr/flatpickr.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/rCSS/admin-orders.css" rel="stylesheet" type="text/css" />
<%- contentFor('body') %>

<div class="row">
  <div class="col-lg-12">
    <div class="card admin-data-card" id="orderList">
      <div class="card-header border-0">
        <div class="row align-items-center gy-3">
          <div class="col-sm">
            <h5 class="card-title mb-0">Orders</h5>
            <p class="text-muted small mb-0 mt-1">Search, filter by zone, business, status, and payment. Manage deliveries across governorates.</p>
          </div>
          <div class="col-sm-auto">
            <div class="d-flex gap-1 flex-wrap align-items-center justify-content-end" id="orders-header-actions">
              <button type="button" class="btn btn-info" id="orders-import-btn"><i class="ri-file-download-line align-bottom me-1"></i> Import</button>
              <button type="button" class="btn btn-success" id="orders-bulk-complete-btn" style="display: none;" onclick="completeMultiple()"><i class="ri-checkbox-circle-line me-1"></i> Complete selected</button>
              <button type="button" class="btn btn-soft-warning" id="orders-bulk-cancel-btn" style="display: none;" onclick="deleteMultiple()"><i class="ri-close-circle-line me-1"></i> Cancel selected</button>
              <button type="button" class="btn btn-danger" id="orders-bulk-delete-btn" style="display: none;" onclick="forceDeleteMultiple()"><i class="ri-delete-bin-2-line me-1"></i> Delete selected</button>
            </div>
          </div>
        </div>
      </div>

      <div class="card-body border border-dashed border-end-0 border-start-0 admin-orders-filters-wrap py-2">
        <form class="admin-orders-filters" id="adminOrdersFilters" onsubmit="return false;">
          <div class="admin-orders-filter-block admin-orders-filter-block--quick">
            <div class="admin-orders-filter-block__head admin-orders-filter-block__head--compact">
              <span class="admin-orders-filter-block__icon"><i class="ri-search-line"></i></span>
              <span class="admin-orders-filter-block__title">Quick search</span>
            </div>
            <div class="row g-2 align-items-end">
              <div class="col-lg-5 col-md-6">
                <label class="form-label" for="adminOrdersSearch">Search</label>
                <div class="search-box">
                  <input type="text" id="adminOrdersSearch" class="form-control form-control-sm search" placeholder="Order #, customer, phone…" autocomplete="off">
                  <i class="ri-search-line search-icon"></i>
                </div>
              </div>
              <div class="col-lg-4 col-md-6">
                <label class="form-label" for="demo-datepicker">Date range</label>
                <div class="admin-orders-input-icon">
                  <i class="ri-calendar-line"></i>
                  <input type="text" class="form-control form-control-sm" id="demo-datepicker" placeholder="Range or single day" autocomplete="off">
                </div>
              </div>
              <div class="col-lg-3 col-12">
                <div class="admin-orders-filter-actions">
                  <button type="button" class="btn btn-primary btn-sm" id="adminOrdersApplyFilters">
                    <i class="ri-filter-3-line me-1"></i> Apply
                  </button>
                  <button type="button" class="btn btn-soft-secondary btn-sm" id="adminOrdersClearFilters">
                    <i class="ri-refresh-line me-1"></i> Clear
                  </button>
                </div>
              </div>
            </div>
          </div>

          <button type="button" class="admin-orders-advanced-toggle" id="adminOrdersAdvancedToggle" aria-expanded="false" aria-controls="adminOrdersAdvancedPanel">
            <span class="admin-orders-advanced-toggle__label">
              <i class="ri-equalizer-2-line"></i> Advanced search
            </span>
            <span class="admin-orders-advanced-toggle__hint">Zone, business, status &amp; payment</span>
            <i class="ri-arrow-down-s-line admin-orders-advanced-toggle__chevron" aria-hidden="true"></i>
          </button>

          <div class="admin-orders-advanced-panel" id="adminOrdersAdvancedPanel" hidden>
          <div class="admin-orders-filter-block">
            <div class="admin-orders-filter-block__head admin-orders-filter-block__head--compact">
              <span class="admin-orders-filter-block__icon"><i class="ri-map-pin-line"></i></span>
              <span class="admin-orders-filter-block__title">Zone &amp; business</span>
            </div>
            <div class="row g-2">
              <div class="col-xl-2 col-md-4">
                <label class="form-label" for="filterGovernment">Governorate</label>
                <select class="form-select form-select-sm" id="filterGovernment">
                  <option value="">All governorates</option>
                </select>
              </div>
              <div class="col-xl-2 col-md-4">
                <label class="form-label" for="filterZone">Zone</label>
                <select class="form-select form-select-sm" id="filterZone" disabled>
                  <option value="">All zones</option>
                </select>
              </div>
              <div class="col-xl-5 col-md-8">
                <label class="form-label" for="businessFilterSearch">Business</label>
                <div class="admin-orders-business-filter">
                  <div class="search-box mb-1">
                    <input type="text" class="form-control form-control-sm" id="businessFilterSearch" placeholder="Search businesses…" autocomplete="off">
                    <i class="ri-store-2-line search-icon"></i>
                  </div>
                  <select class="form-select form-select-sm" id="filterBusinessId">
                    <option value="">All businesses</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <div class="admin-orders-filter-block admin-orders-filter-block--last">
            <div class="admin-orders-filter-block__head admin-orders-filter-block__head--compact">
              <span class="admin-orders-filter-block__icon"><i class="ri-equalizer-line"></i></span>
              <span class="admin-orders-filter-block__title">Status &amp; payment</span>
            </div>
            <div class="row g-2">
              <div class="col-xl-3 col-md-6">
                <label class="form-label" for="orderStatus">Delivery status</label>
                <select class="form-select form-select-sm" id="orderStatus">
                  <option value="all" selected>All</option>
                  <option value="new">New</option>
                  <option value="pickedUp">Picked Up</option>
                  <option value="inStock">In Stock</option>
                  <option value="inProgress">In Progress</option>
                  <option value="headingToCustomer">Heading To Customer</option>
                  <option value="headingToYou">Heading To You</option>
                  <option value="completed">Completed</option>
                  <option value="canceled">Canceled</option>
                  <option value="rejected">Customer refused</option>
                  <option value="returned">Returned</option>
                  <option value="terminated">Terminated</option>
                  <option value="waitingAction">Waiting Action</option>
                  <option value="returnInitiated">Return Initiated</option>
                  <option value="returnAssigned">Return Assigned</option>
                  <option value="returnPickedUp">Return Picked Up</option>
                  <option value="returnAtWarehouse">At Warehouse</option>
                  <option value="returnToBusiness">Returning to Business</option>
                  <option value="inReturnStock">In Return Stock</option>
                  <option value="returnCompleted">Return Completed</option>
                  <option value="exchangePickup">Exchange Pickup (legacy)</option>
                  <option value="deliveryFailed">Delivery Failed</option>
                  <option value="rescheduled">Rescheduled</option>
                </select>
              </div>
              <div class="col-xl-3 col-md-6">
                <label class="form-label" for="idStatusCategory">Status category</label>
                <select class="form-select form-select-sm" id="idStatusCategory">
                  <option value="all" selected>All</option>
                  <option value="NEW">New</option>
                  <option value="PROCESSING">Processing</option>
                  <option value="PAUSED">Paused</option>
                  <option value="SUCCESSFUL">Successful</option>
                  <option value="UNSUCCESSFUL">Unsuccessful</option>
                </select>
              </div>
              <div class="col-xl-3 col-md-6">
                <label class="form-label" for="idPayment">Payment type</label>
                <select class="form-select form-select-sm" id="idPayment">
                  <option value="all" selected>All</option>
                  <option value="COD">COD</option>
                  <option value="CD">CD</option>
                  <option value="NA">NA</option>
                </select>
              </div>
              <div class="col-xl-3 col-md-6">
                <label class="form-label" for="filterIsExpress">Shipping speed</label>
                <select class="form-select form-select-sm" id="filterIsExpress">
                  <option value="all" selected>All</option>
                  <option value="true">Fast only</option>
                  <option value="false">Standard only</option>
                </select>
              </div>
            </div>
          </div>
          </div>
        </form>
      </div>

      <div class="card-body pt-0">
        <div class="admin-orders-chips-bar" id="adminOrdersFilterChips" aria-live="polite"></div>

        <div class="admin-orders-toolbar">
          <p class="admin-orders-results-summary mb-0" id="adminOrdersResultsSummary"></p>
          <ul class="nav nav-tabs nav-tabs-custom nav-success admin-orders-tabs flex-wrap mb-0" role="tablist">
            <li class="nav-item">
              <button type="button" class="btn orderType btn-link nav-link active" data-order-type="All" role="tab" aria-selected="true" onclick="filterOrders('All')">
                <i class="ri-store-2-fill me-1 align-bottom"></i> All Orders
              </button>
            </li>
            <li class="nav-item">
              <button type="button" class="btn orderType btn-link nav-link" data-order-type="Deliver" role="tab" aria-selected="false" onclick="filterOrders('Deliver')">
                <i class="ri-truck-line me-1 align-bottom"></i> Deliver
              </button>
            </li>
            <li class="nav-item">
              <button type="button" class="btn orderType btn-link nav-link" data-order-type="Return" role="tab" aria-selected="false" onclick="filterOrders('Return')">
                <i class="ri-arrow-left-right-fill me-1 align-bottom"></i> Returns
              </button>
            </li>
            <li class="nav-item">
              <button type="button" class="btn orderType btn-link nav-link" data-order-type="Exchange" role="tab" aria-selected="false" onclick="filterOrders('Exchange')">
                <i class="ri-exchange-line me-1 align-bottom"></i> Exchange
              </button>
            </li>
          </ul>
        </div>

        <div class="admin-table-scroll admin-orders-table-wrap mb-1">
          <table class="table table-nowrap table-striped align-middle mb-0 admin-data-table admin-orders-table" id="orderTable">
            <thead class="text-muted">
              <tr>
                <th scope="col" style="width: 42px;">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                  </div>
                </th>
                <th>Order ID</th>
                <th>Business</th>
                <th>Customer</th>
                <th>Order type</th>
                <th>Governorate</th>
                <th>Zone</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Courier</th>
                <th>Order date</th>
                <th class="admin-orders-col-actions">Actions</th>
              </tr>
            </thead>
            <tbody class="list form-check-all" id="ordersTable"></tbody>
          </table>
        </div>

        <div class="noresult py-5" id="NoResult" style="display: none">
          <div class="text-center">
            <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#405189,secondary:#0ab39c" style="width:75px;height:75px"></lord-icon>
            <h5 class="mt-2">No orders match your filters</h5>
            <p class="text-muted mb-0">Try clearing filters or broadening the date range.</p>
          </div>
        </div>

        <div class="admin-orders-pagination-bar">
          <span class="admin-orders-results-summary" id="adminOrdersPaginationSummary"></span>
          <div class="pagination-wrap hstack gap-2">
            <a class="page-item pagination-prev disabled" href="javascript:void(0);">Previous</a>
            <ul class="pagination listjs-pagination mb-0"></ul>
            <a class="page-item pagination-next" href="javascript:void(0);">Next</a>
          </div>
        </div>
      </div>

      <!-- Assign Delivery Man Modal -->
      <div class="modal fade" id="assignDeliveryManModal" tabindex="-1" aria-labelledby="assignDeliveryManModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="assignDeliveryManModalLabel">Assign Delivery Man</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div id="loader" class="text-center" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
              </div>
              <form id="assignDeliveryManForm">
                <input type="hidden" id="orderId" name="orderId" value="">
                <div class="mb-3">
                  <label for="deliveryMan" class="form-label">Select Delivery Man</label>
                  <select class="form-select" id="deliveryMan" name="deliveryMan" required>
                    <option value="">Select a delivery man</option>
                  </select>
                </div>
                <div class="d-flex justify-content-end">
                  <button type="submit" class="btn btn-primary">Assign</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Print Policy Modal -->
      <div class="modal fade" id="printPolicyModal" tabindex="-1" aria-labelledby="printPolicyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="printPolicyModalLabel">Download AWB (Delivery Policy)</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <p>Select the paper size for the delivery policy (AWB):</p>
              <form id="printPolicyForm">
                <input type="hidden" id="printPolicyOrderId" name="orderId" value="">
                <div class="d-flex justify-content-around">
                  <div class="paper-size-option" onclick="selectPaperSize('A4')">
                    <img src="/assets/images/a4.png" alt="A4" style="width: 100px; height: 100px;">
                    <p>A4</p>
                  </div>
                  <div class="paper-size-option" onclick="selectPaperSize('A6')">
                    <img src="/assets/images/a6.png" alt="A6" style="width: 100px; height: 100px;">
                    <p>A6</p>
                  </div>
                </div>
                <input type="hidden" id="paperSize" name="paperSize" value="">
                <div class="d-flex justify-content-end mt-3">
                  <button type="button" class="btn btn-primary" onclick="printPolicy()">Download</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Assign Return Courier Modal -->
      <div class="modal fade" id="assignReturnCourierModal" tabindex="-1" aria-labelledby="assignReturnCourierModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="assignReturnCourierModalLabel">Assign Courier for Return</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div id="returnCourierLoader" class="text-center" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
              </div>
              <form id="assignReturnCourierForm">
                <input type="hidden" id="returnOrderId" name="returnOrderId" value="">
                <div class="mb-3">
                  <label for="returnCourier" class="form-label">Select Courier</label>
                  <select class="form-select" id="returnCourier" name="returnCourier" required>
                    <option value="">Select a courier</option>
                  </select>
                </div>
                <div class="d-flex justify-content-end">
                  <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-primary">Assign</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Schedule Retry Modal -->
      <div class="modal fade" id="scheduleRetryModal" tabindex="-1" aria-labelledby="scheduleRetryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="scheduleRetryModalLabel">Schedule delivery retry</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <form id="scheduleRetryForm">
                <input type="hidden" id="scheduleRetryOrderId" name="orderId" value="">
                <p class="text-muted small mb-3">Choose when this order should be attempted again. The business will see the scheduled retry on their orders page.</p>
                <div class="mb-3">
                  <label for="scheduleRetryDate" class="form-label">Retry date &amp; time</label>
                  <input type="datetime-local" id="scheduleRetryDate" name="date" class="form-control" required>
                </div>
                <div class="d-flex justify-content-end gap-2">
                  <button type="button" class="btn btn-soft-secondary" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-primary">Schedule retry</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/libs/sweetalert2/sweetalert2.min.js"></script>
<script src="/assets/libs/flatpickr/flatpickr.min.js"></script>
<script src="/assets/rJS/admin/orders.js"></script>
