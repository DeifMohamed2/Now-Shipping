<%- contentFor('HeaderCss') %>
<link href="/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/flatpickr/flatpickr.min.css" rel="stylesheet" type="text/css" />
<link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
<link href="/assets/rCSS/admin-couriers.css" rel="stylesheet" type="text/css" />

<%- contentFor('body') %>

<div class="couriers-page">
  <!-- Stats -->
  <div class="row g-3">
    <div class="col-md-3 col-sm-6">
      <div class="card stats-card border-0">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-primary-subtle text-primary"><i class="ri-team-line fs-5"></i></div>
            <div class="ms-3">
              <h6 class="mb-0 text-muted small">Total Couriers</h6>
              <h4 class="mt-1 mb-0 fw-semibold" id="statTotalCouriers">0</h4>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card stats-card border-0">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-success-subtle text-success"><i class="ri-user-follow-line fs-5"></i></div>
            <div class="ms-3">
              <h6 class="mb-0 text-muted small">Active</h6>
              <h4 class="mt-1 mb-0 fw-semibold" id="statActiveCouriers">0</h4>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card stats-card border-0">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-warning-subtle text-warning"><i class="ri-truck-line fs-5"></i></div>
            <div class="ms-3">
              <h6 class="mb-0 text-muted small">On Route</h6>
              <h4 class="mt-1 mb-0 fw-semibold" id="statOnRoute">0</h4>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card stats-card border-0">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-info-subtle text-info"><i class="ri-map-pin-line fs-5"></i></div>
            <div class="ms-3">
              <h6 class="mb-0 text-muted small">Zones Covered</h6>
              <h4 class="mt-1 mb-0 fw-semibold" id="statZonesCovered">0</h4>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main panel -->
  <div class="card couriers-panel border-0 shadow-sm" id="courierList">
    <div class="couriers-panel__top">
      <div>
        <h5 class="couriers-panel__title">Couriers</h5>
        <p class="couriers-panel__subtitle">Manage delivery personnel and zone coverage</p>
      </div>
      <div class="d-flex gap-2 flex-wrap align-items-center">
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addCourierModal">
          <i class="ri-user-add-line me-1"></i> Add Courier
        </button>
        <div class="dropdown">
          <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown">
            <i class="ri-file-download-line me-1"></i> Export
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm">
            <li><button type="button" class="dropdown-item" onclick="exportCouriers('excel')"><i class="ri-file-excel-2-line me-2 text-success"></i>Excel (.xls)</button></li>
            <li><button type="button" class="dropdown-item" onclick="exportCouriers('csv')"><i class="ri-file-text-line me-2 text-primary"></i>CSV</button></li>
          </ul>
        </div>
        <div id="courier-bulk-toolbar" class="d-none flex-wrap gap-2 align-items-center">
          <button type="button" class="btn btn-soft-warning btn-sm" id="bulk-deactivate-couriers"><i class="ri-user-unfollow-line"></i> Deactivate</button>
          <button type="button" class="btn btn-soft-danger btn-sm" id="remove-actions"><i class="ri-delete-bin-2-line"></i> Delete</button>
        </div>
      </div>
    </div>

    <div class="couriers-filter-bar">
      <div class="row g-3 align-items-end">
        <div class="col-xl-4 col-lg-5 col-md-6">
          <label class="filter-label" for="courierSearch">Search</label>
          <div class="search-box">
            <input type="text" class="form-control" id="courierSearch" placeholder="ID, name, phone, zones…">
            <i class="ri-search-line search-icon"></i>
          </div>
        </div>
        <div class="col-xl-2 col-lg-2 col-md-4 col-sm-6">
          <label class="filter-label" for="courierStatusFilter">Status</label>
          <select class="form-select" id="courierStatusFilter">
            <option value="all">All</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>
        <div class="col-xl-2 col-lg-2 col-md-4 col-sm-6">
          <label class="filter-label" for="courierZoneFilter">Zone</label>
          <select class="form-select" id="courierZoneFilter">
            <option value="">All zones</option>
          </select>
        </div>
        <div class="col-xl-2 col-lg-2 col-md-4 col-sm-6">
          <label class="filter-label" for="courierDateRange">Created</label>
          <input type="text" class="form-control" id="courierDateRange" placeholder="Date range" autocomplete="off">
        </div>
        <div class="col-xl-2 col-lg-1 col-md-4 col-sm-6">
          <label class="filter-label d-none d-md-block">&nbsp;</label>
          <div class="couriers-filter-actions">
            <button type="button" class="btn btn-primary flex-grow-1" onclick="applyCourierFilters()"><i class="ri-filter-3-line me-1"></i> Apply</button>
            <button type="button" class="btn btn-light" onclick="clearAllCourierFilters()" title="Clear"><i class="ri-close-circle-line"></i></button>
          </div>
        </div>
      </div>
    </div>

    <div class="couriers-meta-bar">
      <span class="couriers-results-count" id="couriersResultsCount">Showing <strong>0</strong> of <strong>0</strong> couriers</span>
      <div class="couriers-chips" id="couriersFilterChips"></div>
    </div>

    <div class="couriers-panel__body">
      <div class="couriers-table-wrap">
        <div class="admin-table-scroll">
          <table class="table table-nowrap table-hover align-middle admin-data-table mb-0" id="courierTable">
            <thead class="text-muted table-light">
              <tr class="text-uppercase">
                <th style="width:25px"><div class="form-check"><input class="form-check-input" type="checkbox" id="checkAll"></div></th>
                <th>Courier</th>
                <th>Contact</th>
                <th class="zones-col">Zones</th>
                <th>Active Tasks</th>
                <th>Orders</th>
                <th>Pickups</th>
                <th>Status</th>
                <th>Created</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody class="list form-check-all" id="couriersTable"></tbody>
          </table>
          <div class="noresult" style="display:none">
            <div class="text-center py-4">
              <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#405189,secondary:#0ab39c" style="width:75px;height:75px"></lord-icon>
              <h5 class="mt-2">No couriers found</h5>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Courier Modal -->
<div class="modal fade" id="addCourierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <form id="addCourierForm" class="modal-content courier-modal">
      <div class="modal-header courier-modal__header">
        <div>
          <h5 class="modal-title mb-0">Add New Courier</h5>
          <p class="courier-modal__subtitle mb-0">Create account and assign delivery zones</p>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body courier-modal__body p-0">
        <div class="courier-modal__section">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Full Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="fullName" id="firstName" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Personal Email</label>
              <input type="email" class="form-control" name="personalEmail" id="email">
            </div>
            <div class="col-md-6">
              <label class="form-label">Phone <span class="text-danger">*</span></label>
              <input type="tel" class="form-control" name="phoneNumber" id="phone" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">National ID <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="nationalId" id="nationalId" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Date of Birth <span class="text-danger">*</span></label>
              <input type="date" class="form-control" name="dateOfBirth" id="dateOfBirth" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Vehicle Type <span class="text-danger">*</span></label>
              <select class="form-select" name="vehicleType" id="vehicleType" required>
                <option value="">Select</option>
                <option value="Motorcycle">Motorcycle</option>
                <option value="Car">Car</option>
                <option value="Van">Van</option>
                <option value="Bicycle">Bicycle</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Plate Number <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="vehiclePlateNumber" id="vehiclePlate" required>
            </div>
            <div class="col-12">
              <label class="form-label">Address <span class="text-danger">*</span></label>
              <textarea class="form-control" name="address" id="address" rows="2" required></textarea>
            </div>
          </div>
        </div>
        <div class="courier-modal__section">
          <div class="courier-modal__section-label">
            <i class="ri-map-pin-line"></i> Delivery Zones <span class="text-danger">*</span>
            <span class="count-badge" id="addCourierZoneCount">0</span>
          </div>
          <div class="zone-chips mb-2" id="addCourierSelectedZonesTags"></div>
          <button type="button" class="zone-picker-cta" id="openAddCourierZoneSelectionBtn">
            <span><i class="ri-map-pin-add-line me-2"></i>Browse zones — select full zones or individual areas</span>
            <i class="ri-arrow-right-s-line"></i>
          </button>
        </div>
        <div class="courier-modal__section">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Login Email <span class="text-danger">*</span></label>
              <input type="email" class="form-control" name="email" id="username" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Password <span class="text-danger">*</span></label>
              <div class="position-relative">
                <input type="password" class="form-control" name="password" id="password" required>
                <button type="button" class="btn btn-link position-absolute end-0 top-0 text-muted password-addon" onclick="togglePassword()"><i class="ri-eye-fill"></i></button>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Photo</label>
              <input type="file" class="form-control" id="courierPhoto" accept="image/*">
              <div class="form-text" id="photoStatus">Upload required before create</div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer courier-modal__footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" id="addCourierBtn">Create Courier</button>
      </div>
    </form>
  </div>
</div>

<!-- Assign Zones Modal -->
<div class="modal fade" id="assignZonesModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content courier-modal">
      <div class="modal-header courier-modal__header">
        <div>
          <h5 class="modal-title mb-0"><i class="ri-map-pin-line me-2"></i>Assign Delivery Zones</h5>
          <p class="courier-modal__subtitle mb-0">Configure coverage — use full zone for all sub-areas at once</p>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body courier-modal__body p-0">
        <input type="hidden" id="courierIdForZones">
        <div class="courier-modal__section">
          <div class="courier-summary">
            <img src="/placeholder.svg?height=52&width=52" id="courierAvatarForZones" class="courier-summary__avatar" alt="">
            <div>
              <p class="courier-summary__name" id="courierNameForZones">—</p>
              <div class="courier-summary__meta">
                <span><i class="ri-phone-line me-1"></i><span id="courierPhoneForZones">—</span></span>
              </div>
            </div>
          </div>
        </div>
        <div class="courier-modal__section">
          <div class="courier-modal__section-label">
            <i class="ri-map-2-line"></i> Currently Assigned
            <span class="count-badge" id="currentZoneCount">0</span>
          </div>
          <div class="zone-chips" id="currentZones"></div>
        </div>
        <div class="courier-modal__section">
          <div class="courier-modal__section-label">
            <i class="ri-add-circle-line"></i> Add Zones
            <span class="count-badge" id="pendingZoneCount">0</span>
          </div>
          <div class="zone-chips mb-2" id="selectedZonesTags"></div>
          <button type="button" class="zone-picker-cta" id="openZoneSelectionBtn">
            <span><i class="ri-map-pin-add-line me-2"></i>Browse &amp; select zones</span>
            <i class="ri-arrow-right-s-line"></i>
          </button>
        </div>
        <div class="courier-modal__section">
          <label class="form-label small text-muted text-uppercase fw-semibold">Notes (optional)</label>
          <textarea class="form-control" id="zoneNotes" rows="2" placeholder="Assignment notes…"></textarea>
        </div>
      </div>
      <div class="modal-footer courier-modal__footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveZonesBtn"><i class="ri-save-line me-1"></i>Save Assignments</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit Courier Modal -->
<div class="modal fade" id="editCourierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content courier-modal">
      <div class="modal-header courier-modal__header">
        <div>
          <h5 class="modal-title mb-0">Edit Courier</h5>
          <p class="courier-modal__subtitle mb-0">Update profile details (zones via Assign Zones)</p>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body courier-modal__body">
        <form id="editCourierForm">
          <input type="hidden" id="editCourierId">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">First Name</label>
              <input type="text" class="form-control" id="editFirstName" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Last Name</label>
              <input type="text" class="form-control" id="editLastName" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" id="editEmail" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Phone</label>
              <input type="tel" class="form-control" id="editPhone" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Vehicle</label>
              <select class="form-select" id="editVehicleType">
                <option value="">Select</option>
                <option value="Motorcycle">Motorcycle</option>
                <option value="Car">Car</option>
                <option value="Van">Van</option>
                <option value="Bicycle">Bicycle</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Status</label>
              <select class="form-select" id="editStatus">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label">Address</label>
              <textarea class="form-control" id="editAddress" rows="2"></textarea>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer courier-modal__footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="updateCourierBtn" disabled title="Coming soon">Update</button>
      </div>
    </div>
  </div>
</div>

<!-- View Courier Zones Modal -->
<div class="modal fade" id="viewCourierZonesModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content courier-modal">
      <div class="modal-header courier-modal__header">
        <div>
          <h5 class="modal-title mb-0"><i class="ri-map-pin-line me-2"></i>Delivery Zones</h5>
          <p class="courier-modal__subtitle mb-0" id="viewZonesSubtitle">Assigned coverage</p>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body courier-modal__body p-0">
        <div class="courier-modal__section">
          <div class="courier-summary">
            <img src="/placeholder.svg?height=52&width=52" id="viewZonesAvatar" class="courier-summary__avatar" alt="">
            <div>
              <p class="courier-summary__name" id="viewZonesName">—</p>
              <div class="courier-summary__meta">
                <span><i class="ri-phone-line me-1"></i><span id="viewZonesPhone">—</span></span>
                <span><i class="ri-hashtag me-1"></i><span id="viewZonesId">—</span></span>
              </div>
            </div>
          </div>
        </div>
        <div class="courier-modal__section zone-view-stats">
          <div class="zone-view-stat">
            <span class="zone-view-stat__value" id="viewZonesGroupCount">0</span>
            <span class="zone-view-stat__label">Zones</span>
          </div>
          <div class="zone-view-stat">
            <span class="zone-view-stat__value" id="viewZonesAreaCount">0</span>
            <span class="zone-view-stat__label">Areas</span>
          </div>
          <div class="zone-view-stat zone-view-stat--full">
            <span class="zone-view-stat__value" id="viewZonesFullCount">0</span>
            <span class="zone-view-stat__label">Full zones</span>
          </div>
        </div>
        <div class="courier-modal__section zone-view-toolbar">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-white"><i class="ri-search-line text-muted"></i></span>
            <input type="search" class="form-control" id="viewZonesSearch" placeholder="Search zones or areas…" autocomplete="off">
          </div>
        </div>
        <div class="zone-view-list-wrap">
          <div id="viewZonesList" class="zone-view-list"></div>
          <div id="viewZonesEmpty" class="zone-view-empty d-none">
            <i class="ri-search-line"></i>
            <p>No zones match your search.</p>
          </div>
        </div>
      </div>
      <div class="modal-footer courier-modal__footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" id="viewZonesAssignBtn"><i class="ri-map-pin-add-line me-1"></i>Assign Zones</button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/courier-zone-picker-modal') %>

<%- contentFor('FooterJs') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/assets/libs/flatpickr/flatpickr.min.js"></script>
<script src="/assets/rJS/admin/courier-zone-catalog.js"></script>
<script src="/assets/rJS/admin/courier-zone-picker.js"></script>
<script src="/assets/rJS/admin/couriers-page.js"></script>
