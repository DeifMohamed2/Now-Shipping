<%- contentFor('HeaderCss') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.7.6/lottie.min.js"></script>
<link href="/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/choices.js/public/assets/styles/choices.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/flatpickr/flatpickr.min.css" rel="stylesheet" type="text/css" />
<link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">

<%- contentFor('body') %>
<style>
  .stock-page .stats-card {
    border: 1px solid rgba(64, 81, 137, 0.08);
    border-radius: 12px;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .stock-page .stats-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(64, 81, 137, 0.1);
  }

  .stock-page .stats-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
  }

  .stock-page .quick-add-form {
    background: linear-gradient(135deg, #f8f9fc 0%, #f3f6fb 100%);
    border: 1px solid rgba(64, 81, 137, 0.08);
    border-radius: 12px;
    padding: 20px;
  }

  .stock-page .status-badge {
    padding: 5px 10px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .stock-advanced-filters {
    background: #fafbfe;
    border: 1px solid rgba(64, 81, 137, 0.1);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 0;
  }

  .stock-advanced-filters .filter-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #878a99;
    margin-bottom: 0.35rem;
  }

  .stock-advanced-filters .search-box {
    position: relative;
  }

  .stock-advanced-filters .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #878a99;
    pointer-events: none;
  }

  .stock-advanced-filters .search-box input {
    padding-left: 2.25rem;
    border-radius: 8px;
    border-color: #e9ebec;
  }

  .stock-advanced-filters .form-control,
  .stock-advanced-filters .form-select {
    border-radius: 8px;
    border-color: #e9ebec;
    font-size: 0.875rem;
  }

  .filter-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(64, 81, 137, 0.08);
  }

  .filter-results-count {
    font-size: 0.8125rem;
    color: #495057;
    font-weight: 500;
  }

  .filter-results-count strong {
    color: #405189;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    flex: 1;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    background: #fff;
    border: 1px solid #d0d5dd;
    border-radius: 999px;
    font-size: 0.75rem;
    color: #405189;
  }

  .filter-chip button {
    border: none;
    background: none;
    padding: 0;
    line-height: 1;
    color: #878a99;
    cursor: pointer;
  }

  .filter-chip button:hover {
    color: #f06548;
  }

  .stock-page .nav-tabs-custom {
    border-bottom: 2px solid #eef0f4;
    gap: 0.25rem;
  }

  .stock-page .nav-tabs-custom .nav-link {
    border: none;
    border-radius: 8px 8px 0 0;
    padding: 0.5rem 1rem;
    color: #878a99;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .stock-page .nav-tabs-custom .nav-link.active {
    color: #405189;
    background: #fff;
    box-shadow: inset 0 -2px 0 #405189;
  }

  .stock-page .zone-container {
    margin-bottom: 1.25rem;
    border: 1px solid rgba(64, 81, 137, 0.1);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }

  .stock-page .zone-header {
    background: linear-gradient(90deg, #f8f9fc 0%, #fff 100%);
    border-bottom: 1px solid rgba(64, 81, 137, 0.08);
    padding: 0.85rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease;
  }

  .stock-page .zone-header:hover {
    background: #f3f6fb;
  }

  .stock-page .zone-header.collapsed .zone-chevron {
    transform: rotate(-90deg);
  }

  .stock-page .zone-chevron {
    transition: transform 0.2s ease;
    color: #405189;
    font-size: 1.25rem;
  }

  .stock-page .zone-title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #212529;
  }

  .stock-page .zone-badge {
    font-size: 0.7rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .stock-page .zone-actions {
    display: flex;
    gap: 0.5rem;
  }

  .stock-page .admin-data-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #f3f6f9 !important;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    border-bottom: 1px solid #e9ebec;
  }

  .stock-page .admin-data-table tbody tr:hover {
    background-color: rgba(64, 81, 137, 0.03);
  }

  .stock-page .bulk-actions {
    display: none;
    background: linear-gradient(90deg, #405189 0%, #364574 100%);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    color: #fff;
  }

  .stock-page .bulk-actions.show {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stock-page .bulk-actions-title {
    font-weight: 500;
    margin-bottom: 0;
    color: #fff;
  }

  .stock-page .bulk-actions-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .return-reason-badge {
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .stock-advanced-filters .choices {
    margin-bottom: 0;
    font-size: 0.875rem;
  }

  .stock-advanced-filters .choices__inner {
    min-height: 38px;
    border-radius: 8px;
    border-color: #e9ebec;
    padding: 4px 8px;
    background: #fff;
  }

  .stock-advanced-filters .choices__list--multiple .choices__item {
    background: #405189;
    border: 1px solid #405189;
    border-radius: 6px;
    font-size: 0.72rem;
    margin-bottom: 2px;
    max-width: 100%;
    white-space: normal;
    word-break: break-word;
  }

  .stock-advanced-filters .choices__input {
    background: transparent;
    margin-bottom: 0;
    font-size: 0.8125rem;
  }

  .stock-advanced-filters .choices__list--dropdown {
    z-index: 1060;
    border-radius: 8px;
    border-color: #e9ebec;
    max-height: 280px;
    overflow-y: auto;
    box-shadow: 0 8px 24px rgba(64, 81, 137, 0.12);
  }

  .stock-advanced-filters .choices__list--dropdown .choices__item--selectable.is-highlighted {
    background: #f3f6fb;
  }

  .stock-advanced-filters .choices.is-open .choices__inner {
    border-color: #405189;
    box-shadow: 0 0 0 3px rgba(64, 81, 137, 0.1);
  }

  .stock-advanced-filters .choices[data-type*="select-multiple"] .choices__inner {
    min-height: 42px;
    padding: 6px 10px;
  }

  .stock-advanced-filters .choices__list--dropdown .choices__item {
    font-size: 0.8125rem;
    padding: 8px 12px;
    white-space: normal;
    word-break: break-word;
  }

  .unified-stock-table-wrap {
    border: 1px solid rgba(64, 81, 137, 0.1);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }

  .unified-stock-table-wrap .admin-table-scroll {
    max-height: 68vh;
    overflow: auto;
  }

  .zone-cell-badge {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.3rem;
    max-width: 260px;
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.35;
    white-space: normal;
    word-break: break-word;
    text-align: left;
  }

  .zone-cell-badge i { flex-shrink: 0; font-size: 0.8rem; }
  .zone-badge-0 { background: #e8eeff; color: #405189; }
  .zone-badge-1 { background: #e6f4f1; color: #0ab39c; }
  .zone-badge-2 { background: #fff4e6; color: #f7b84b; }
  .zone-badge-3 { background: #fde8e4; color: #f06548; }
  .zone-badge-4 { background: #ebeff2; color: #495057; }
  .zone-badge-5 { background: #f3e8fd; color: #6559cc; }

  .stock-page .admin-data-table tbody tr.zone-group-start td {
    border-top: 2px solid rgba(64, 81, 137, 0.12);
  }

  .sortable-th { cursor: pointer; user-select: none; }
  .sortable-th:hover { color: #405189; }
  .sortable-th .sort-icon { font-size: 0.85rem; opacity: 0.5; }
  .sortable-th.sorted .sort-icon { opacity: 1; color: #405189; }
</style>

<div class="row stock-page">
  <!-- Stats Cards -->
  <div class="col-lg-12 mb-4">
    <div class="row g-3">
      <div class="col-md-3">
        <div class="card stats-card border-0 shadow-sm">
          <div class="card-body py-3">
            <div class="d-flex align-items-center">
              <div class="stats-icon bg-primary-subtle text-primary">
                <i class="ri-arrow-go-back-line fs-5"></i>
              </div>
              <div class="ms-3">
                <h6 class="mb-0 text-muted small">Total Returns</h6>
                <h4 class="mt-1 mb-0 fw-semibold" id="totalReturns">0</h4>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card stats-card border-0 shadow-sm">
          <div class="card-body py-3">
            <div class="d-flex align-items-center">
              <div class="stats-icon bg-warning-subtle text-warning">
                <i class="ri-building-2-line fs-5"></i>
              </div>
              <div class="ms-3">
                <h6 class="mb-0 text-muted small">At Warehouse</h6>
                <h4 class="mt-1 mb-0 fw-semibold" id="atWarehouseCount">0</h4>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card stats-card border-0 shadow-sm">
          <div class="card-body py-3">
            <div class="d-flex align-items-center">
              <div class="stats-icon bg-success-subtle text-success">
                <i class="ri-archive-line fs-5"></i>
              </div>
              <div class="ms-3">
                <h6 class="mb-0 text-muted small">In Return Stock</h6>
                <h4 class="mt-1 mb-0 fw-semibold" id="inReturnStockCount">0</h4>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card stats-card border-0 shadow-sm">
          <div class="card-body py-3">
            <div class="d-flex align-items-center">
              <div class="stats-icon bg-info-subtle text-info">
                <i class="ri-map-pin-line fs-5"></i>
              </div>
              <div class="ms-3">
                <h6 class="mb-0 text-muted small">Zones</h6>
                <h4 class="mt-1 mb-0 fw-semibold" id="returnZonesCount">0</h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Add Return -->
  <div class="col-lg-6 mb-4">
    <div class="card">
      <div class="card-header border-0 bg-light">
        <h5 class="card-title mb-0">Quick Add Return</h5>
      </div>
      <div class="card-body">
        <form id="quickAddForm" class="quick-add-form">
          <div class="row g-3 align-items-end">
            <div class="col-md-7">
              <label for="orderNumber" class="form-label">Order Number</label>
              <div class="input-group">
                <span class="input-group-text">#</span>
                <input type="text" class="form-control" id="orderNumber" placeholder="Enter order number" required>
              </div>
            </div>

            <div class="col-md-12">
              <label for="returnReason" class="form-label">Return Reason</label>
              <select class="form-select" id="returnReason">
                <option value="">Select a reason (optional)</option>
                <option value="Customer requested return">Customer requested return</option>
                <option value="Damaged product">Damaged product</option>
                <option value="Wrong product">Wrong product</option>
                <option value="Quality issues">Quality issues</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="col-md-12">
              <label for="returnNotes" class="form-label">Return Notes</label>
              <textarea class="form-control" id="returnNotes" rows="2" placeholder="Add any additional notes about this return"></textarea>
            </div>

            <div class="col-md-12">
              <button type="submit" class="btn btn-primary w-100">
                <i class="ri-add-line me-1"></i> Add Return
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Main Returns Management Card -->
  <div class="col-lg-12">
    <div class="card" id="returnsList">
      <div class="card-header border-0">
        <div class="row align-items-center gy-3">
          <div class="col-sm">
            <h5 class="card-title mb-0">Returns Management</h5>
          </div>
          <div class="col-sm-auto">
            <div class="d-flex gap-1 flex-wrap align-items-center">
              <div class="dropdown">
                <button type="button" class="btn btn-primary dropdown-toggle" id="exportReturnsBtn" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="ri-file-download-line align-bottom me-1"></i> Export
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                  <li><button type="button" class="dropdown-item" onclick="exportReturnData('excel')"><i class="ri-file-excel-2-line me-2 text-success"></i>Excel (.xls)</button></li>
                  <li><button type="button" class="dropdown-item" onclick="exportReturnData('csv')"><i class="ri-file-text-line me-2 text-primary"></i>CSV</button></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><button type="button" class="dropdown-item" onclick="exportReturnData('print')"><i class="ri-printer-line me-2 text-secondary"></i>Print / PDF</button></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Advanced Filter Section -->
      <div class="card-body border border-dashed border-end-0 border-start-0">
        <div class="stock-advanced-filters">
          <form id="returnsSearchForm" onsubmit="return false;">
            <div class="row g-3 align-items-end">
              <div class="col-lg-4 col-md-6">
                <label class="filter-label" for="returnsSearch">Search</label>
                <div class="search-box">
                  <input type="text" class="form-control" id="returnsSearch" placeholder="Order ID, customer, phone, address...">
                  <i class="ri-search-line search-icon"></i>
                </div>
              </div>
              <div class="col-lg-3 col-md-4 col-sm-6">
                <label class="filter-label" for="zoneFilter">Zones</label>
                <select class="form-control" id="zoneFilter" multiple></select>
              </div>
              <div class="col-lg-2 col-md-3 col-sm-6">
                <label class="filter-label" for="returnsStatusFilter">Status</label>
                <select class="form-select" id="returnsStatusFilter">
                  <option value="all" selected>All Statuses</option>
                  <option value="returnAtWarehouse">At Warehouse</option>
                  <option value="inReturnStock">In Return Stock</option>
                  <option value="returnToBusiness">Returning to Business</option>
                  <option value="returnAssigned">Return Assigned</option>
                </select>
              </div>
              <div class="col-lg-2 col-md-4 col-sm-6">
                <label class="filter-label" for="returnsDateRange">Return Date</label>
                <input type="text" class="form-control" id="returnsDateRange" placeholder="Select return date range" autocomplete="off">
              </div>
              <div class="col-lg-2 col-md-4 col-sm-6">
                <div class="d-flex gap-2">
                  <button type="button" class="btn btn-primary flex-grow-1" onclick="applyReturnFilters()">
                    <i class="ri-filter-3-line me-1"></i> Apply
                  </button>
                  <button type="button" class="btn btn-soft-secondary" onclick="clearReturnFilters()" title="Clear all filters">
                    <i class="ri-close-circle-line"></i>
                  </button>
                </div>
              </div>
            </div>
          </form>
          <div class="filter-meta-bar">
            <span class="filter-results-count" id="returnsResultsCount">Showing <strong>0</strong> of <strong>0</strong> returns</span>
            <div class="filter-chips" id="returnsFilterChips"></div>
          </div>
        </div>
      </div>

      <!-- Returns Table Section -->
      <div class="card-body pt-0">
        <div>
          <ul class="nav nav-tabs nav-tabs-custom nav-success mb-3" role="tablist">
            <li class="nav-item">
              <button class="btn returnFilter btn-link nav-link active All py-2 px-3" type="button" id="tabAllReturns" onClick="filterReturns('all')">
                <i class="ri-store-2-fill me-1 align-bottom"></i> All Returns
              </button>
            </li>
            <li class="nav-item">
              <button class="btn returnFilter btn-link nav-link py-2 px-3 AtWarehouse" type="button" id="tabAtWarehouse" onClick="filterReturns('returnAtWarehouse')">
                <i class="ri-building-2-line me-1 align-bottom"></i> At Warehouse
              </button>
            </li>
            <li class="nav-item">
              <button class="btn returnFilter btn-link nav-link py-2 px-3 InReturnStock" type="button" id="tabInReturnStock" onClick="filterReturns('inReturnStock')">
                <i class="ri-archive-line me-1 align-bottom"></i> In Return Stock
              </button>
            </li>
          </ul>

          <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
            <div class="form-check mb-0">
              <input class="form-check-input" type="checkbox" id="checkAll" title="Select all visible items">
              <label class="form-check-label small text-muted mb-0" for="checkAll">Select all</label>
            </div>
          </div>

          <!-- Bulk Actions Bar (Initially Hidden) -->
          <div id="bulkActionsBar" class="bulk-actions mb-3">
            <div class="bulk-actions-title">
              <span id="selectedItemsCount">0</span> items selected
            </div>
            <div class="bulk-actions-buttons">
              <button class="btn btn-sm btn-success" onclick="assignMultipleReturns()">
                <i class="ri-user-add-line me-1"></i> Assign to Courier
              </button>
              <button class="btn btn-sm btn-info" onclick="printMultipleLabels()">
                <i class="ri-printer-line me-1"></i> Print Labels
              </button>
              <button class="btn btn-sm btn-danger" onclick="deleteMultiple()">
                <i class="ri-delete-bin-2-line me-1"></i> Remove
              </button>
              <button class="btn btn-sm btn-light" onclick="clearSelection()">
                <i class="ri-close-line me-1"></i> Clear Selection
              </button>
            </div>
          </div>


          <!-- Unified returns table -->
          <div id="returnItemsByZone" class="unified-stock-table-wrap">
            <!-- Table rendered here -->
          </div>

          <div class="noresult" id="NoResult" style="display: none">
            <div class="text-center">
              <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#405189,secondary:#0ab39c" style="width:75px;height:75px"></lord-icon>
              <h5 class="mt-2">Sorry! No Result Found</h5>
            </div>
          </div>

          <!-- Pagination -->
          <div class="d-flex justify-content-end mt-3">
            <div class="pagination-wrap hstack gap-2">
              <a class="page-item pagination-prev disabled" href="javascript:void(0);">
                Previous
              </a>
              <ul class="pagination listjs-pagination mb-0"></ul>
              <a class="page-item pagination-next" href="javascript:void(0);">
                Next
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Returns in Progress Cards -->
  <div class="col-lg-12 mb-4">
    <div class="card">
      <div class="card-header border-0 bg-light">
        <h5 class="card-title mb-0">Returns in Progress</h5>
      </div>
      <div class="card-body">
        <div class="row g-3" id="inProgressReturnsCards">
          <!-- Cards will be populated dynamically -->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Update Return Status Modal -->
<div class="modal fade" id="updateReturnStatusModal" tabindex="-1" aria-labelledby="updateReturnStatusModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="updateReturnStatusModalLabel">Update Return Status</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="updateReturnStatusForm">
          <input type="hidden" id="updateOrderId" name="updateOrderId" value="">
          <div class="mb-3">
            <label for="newReturnStatus" class="form-label">Return Status</label>
            <select class="form-select" id="newReturnStatus" name="newReturnStatus" required>
              <option value="">Select new status</option>
              <option value="pendingPickup">Pending Pickup</option>
              <option value="inWarehouse">In Warehouse</option>
              <option value="processing">Processing</option>
              <option value="readyForProcessing">Ready For Processing</option>
              <option value="processed">Processed</option>
              <option value="damaged">Damaged</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="statusNotes" class="form-label">Notes</label>
            <textarea class="form-control" id="statusNotes" name="statusNotes" rows="3" placeholder="Add notes about this status change"></textarea>
          </div>
          <div class="mb-3">
            <label for="warehouseLocation" class="form-label">Warehouse Location</label>
            <input type="text" class="form-control" id="warehouseLocation" name="warehouseLocation" placeholder="e.g., Shelf A-12, Zone B">
          </div>
          <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Update Status</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Assign to Courier Modal -->
