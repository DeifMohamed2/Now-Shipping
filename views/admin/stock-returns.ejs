<%- contentFor('FooterJs') %>
<script src="/assets/libs/list.js/list.min.js"></script>
<script src="/assets/libs/list.pagination.js/list.pagination.min.js"></script>
<script src="/assets/libs/flatpickr/flatpickr.min.js"></script>
<script src="/assets/libs/choices.js/public/assets/scripts/choices.min.js"></script>
<script src="/assets/libs/sweetalert2/sweetalert2.min.js"></script>

<script>
  const returnItemsByZone = document.getElementById("returnItemsByZone");
  const NoResult = document.getElementById("NoResult");
  const checkAll = document.getElementById("checkAll");
  const bulkActionsBar = document.getElementById("bulkActionsBar");
  const selectedItemsCount = document.getElementById("selectedItemsCount");
  let selectedItems = [];
  let allReturnOrders = [];
  let activeReturnTab = 'all';
  let returnSearchDebounce = null;
  let returnZoneChoices = null;
  let returnsDatePicker = null;
  let returnSortField = 'zone';
  let returnSortDir = 'asc';

  // Quick Add Form Submission
  document.getElementById("quickAddForm").addEventListener("submit", async function(e) {
    e.preventDefault();

    const orderNumber = document.getElementById("orderNumber").value.trim();
    const returnReason = document.getElementById("returnReason").value;
    const returnNotes = document.getElementById("returnNotes").value;

    // Show loading indicator
    Swal.fire({
      title: 'Processing...',
      text: 'Adding return to system',
      allowOutsideClick: false,
      didOpen: () => {
        Swal.showLoading();
      }
    });

    try {
      // post request to add return to system
      const response = await fetch('/admin/add-return-to-stock', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          orderNumber,
          returnReason,
          returnNotes
        })
      });

      const data = await response.json();
      console.log(data);

      if (response.ok) {
        Swal.fire({
          icon: 'success',
          title: 'Return Added',
          text: `Order #${orderNumber} has been added to returns system`,
          timer: 2000
        }).then(() => {
          // Reset form and refresh returns data
          document.getElementById("quickAddForm").reset();
          // focus on order number input
          document.getElementById("orderNumber").focus();
          fetchReturnItems();
        });
      } else {
        Swal.fire({
          icon: 'error',
          title: 'Oops...',
          text: `Order #${orderNumber} ${data.error}`,
        });
      }
    } catch (error) {
      console.error("Error adding return to system:", error);
      Swal.fire({
        icon: 'error',
        title: 'Oops...',
        text: `Error adding return to system: ${error.message || 'Unknown error'}`,
      });
    }
  });

  // Fetch return items from server
  async function fetchReturnItems() {
    try {
      returnItemsByZone.innerHTML = `
        <div class="text-center py-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="mt-2 text-muted mb-0">Loading return items...</p>
        </div>
      `;

      const response = await fetch('/admin/get-return-orders');
      const returnItems = await response.json();
      if (!response.ok) {
        throw new Error(returnItems.error || 'Failed to load return orders');
      }

      allReturnOrders = Array.isArray(returnItems) ? returnItems : [];
      populateReturnZoneFilter(allReturnOrders);
      applyReturnFilters();
    } catch (error) {
      returnItemsByZone.innerHTML = '';
      NoResult.style.display = "block";
      console.error("Error fetching return items:", error);
      Swal.fire({
        icon: 'error',
        title: 'Oops...',
        text: `Error fetching return items: ${error.message || 'Unknown error'}`,
      });
    }
  }

  function getReturnOrderZone(item) {
    const zone = item.orderCustomer?.zone;
    return zone && String(zone).trim() ? String(zone).trim() : 'Unassigned';
  }

  function getReturnDate(item) {
    const raw = item.orderStages?.returnAtWarehouse?.completedAt
      || item.orderStages?.inReturnStock?.completedAt
      || item.updatedAt
      || item.orderDate
      || item.createdAt;
    return raw ? new Date(raw) : null;
  }

  function getReturnsDateRangeValue() {
    if (returnsDatePicker && returnsDatePicker.selectedDates.length > 0) {
      return returnsDatePicker.input.value || '';
    }
    return document.getElementById('returnsDateRange')?.value || '';
  }

  function parseReturnsDateRange(dateRange) {
    if (!dateRange || !dateRange.trim()) return null;
    const parts = dateRange.split(/\s+to\s+/i).map((s) => s.trim()).filter(Boolean);
    const parseOne = (s) => {
      const iso = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (iso) return new Date(+iso[1], +iso[2] - 1, +iso[3]);
      const d = new Date(s);
      return Number.isNaN(d.getTime()) ? null : d;
    };
    const from = parseOne(parts[0]);
    if (!from) return null;
    from.setHours(0, 0, 0, 0);
    let to = new Date(from);
    if (parts[1]) {
      const parsedTo = parseOne(parts[1]);
      if (parsedTo) {
        to = parsedTo;
        to.setHours(23, 59, 59, 999);
      } else {
        to.setHours(23, 59, 59, 999);
      }
    } else {
      to.setHours(23, 59, 59, 999);
    }
    return { from, to };
  }

  function initReturnsDatePicker() {
    const el = document.getElementById('returnsDateRange');
    if (!el || typeof flatpickr === 'undefined') return;
    if (returnsDatePicker) {
      returnsDatePicker.destroy();
      returnsDatePicker = null;
    }
    returnsDatePicker = flatpickr(el, {
      mode: 'range',
      dateFormat: 'Y-m-d',
      altInput: true,
      altFormat: 'd M, Y',
      disableMobile: true,
      allowInput: false,
      onChange: function () {
        clearTimeout(returnSearchDebounce);
        returnSearchDebounce = setTimeout(applyReturnFilters, 200);
      },
      onClose: function (selectedDates) {
        if (selectedDates.length > 0) applyReturnFilters();
      },
    });
  }

  function matchesReturnSearch(item, search) {
    if (!search) return true;
    const haystack = [
      item.orderNumber,
      item.orderShipping?.productDescription,
      item.orderCustomer?.fullName,
      item.orderCustomer?.phoneNumber,
      item.orderCustomer?.address,
      item.orderCustomer?.zone,
      item.orderStatus,
      item.orderShipping?.returnReason,
      ...(item.UnavailableReason || []),
    ].filter(Boolean).join(' ').toLowerCase();
    return haystack.includes(search);
  }

  function matchesReturnDateRange(item, dateRange) {
    const range = parseReturnsDateRange(dateRange);
    if (!range) return true;
    const returnDate = getReturnDate(item);
    if (!returnDate || Number.isNaN(returnDate.getTime())) return false;
    return returnDate >= range.from && returnDate <= range.to;
  }

  function matchesReturnTab(item, tab) {
    if (tab === 'all') return true;
    return item.orderStatus === tab;
  }

  function getSelectedReturnZones() {
    const el = document.getElementById('zoneFilter');
    if (returnZoneChoices) {
      const val = returnZoneChoices.getValue(true);
      if (val) {
        const arr = Array.isArray(val) ? val : [val];
        return arr
          .map((v) => (typeof v === 'object' && v != null ? v.value : v))
          .filter(Boolean);
      }
    }
    if (el) {
      return Array.from(el.selectedOptions || []).map((o) => o.value).filter(Boolean);
    }
    return [];
  }

  function initReturnZoneChoices() {
    const el = document.getElementById('zoneFilter');
    if (!el || returnZoneChoices || typeof Choices === 'undefined') return;
    returnZoneChoices = new Choices(el, {
      removeItemButton: true,
      searchEnabled: true,
      searchPlaceholderValue: 'Type to search zones...',
      placeholder: true,
      placeholderValue: 'Select zones (empty = all)',
      itemSelectText: '',
      shouldSort: false,
      position: 'bottom',
      searchResultLimit: 200,
      renderChoiceLimit: 200,
      searchFloor: 1,
      fuseOptions: { threshold: 0.3, ignoreLocation: true },
      closeDropdownOnSelect: false,
      resetScrollPosition: false,
    });

    const onZoneSelectionChange = () => {
      clearTimeout(returnZoneChoices._filterDebounce);
      returnZoneChoices._filterDebounce = setTimeout(applyReturnFilters, 150);
    };

    el.addEventListener('addItem', onZoneSelectionChange);
    el.addEventListener('removeItem', onZoneSelectionChange);
    el.addEventListener('change', onZoneSelectionChange);
  }

  function getReturnFilterState() {
    return {
      search: (document.getElementById('returnsSearch')?.value || '').trim().toLowerCase(),
      zones: getSelectedReturnZones(),
      status: document.getElementById('returnsStatusFilter')?.value || 'all',
      dateRange: getReturnsDateRangeValue(),
      tab: activeReturnTab,
    };
  }

  function populateReturnZoneFilter(orders) {
    initReturnZoneChoices();
    if (!returnZoneChoices) return;
    const selected = getSelectedReturnZones();
    const counts = {};
    orders.forEach((item) => {
      const zone = getReturnOrderZone(item);
      counts[zone] = (counts[zone] || 0) + 1;
    });
    const sortedZones = Object.keys(counts).sort((a, b) => {
      if (a === 'Unassigned') return 1;
      if (b === 'Unassigned') return -1;
      return a.localeCompare(b);
    });
    const choiceItems = sortedZones.map((zone) => ({
      value: zone,
      label: `${zone} (${counts[zone]})`,
      selected: selected.includes(zone),
      disabled: false,
    }));
    returnZoneChoices.setChoices(choiceItems, 'value', 'label', true);
  }

  function updateReturnResultsCount(filteredCount, totalCount) {
    const el = document.getElementById('returnsResultsCount');
    if (!el) return;
    el.innerHTML = `Showing <strong>${filteredCount}</strong> of <strong>${totalCount}</strong> returns`;
  }

  function updateReturnFilterChips(filters) {
    const chipsEl = document.getElementById('returnsFilterChips');
    if (!chipsEl) return;
    chipsEl.innerHTML = '';
    const statusLabels = {
      returnAtWarehouse: 'At Warehouse',
      inReturnStock: 'In Return Stock',
      returnToBusiness: 'Returning to Business',
      returnAssigned: 'Return Assigned',
    };
    const chips = [];
    if (filters.search) chips.push({ key: 'search', label: `Search: ${filters.search}` });
    if (filters.zones && filters.zones.length === 1) {
      chips.push({ key: 'zones', label: `Zone: ${filters.zones[0]}` });
    } else if (filters.zones && filters.zones.length > 1) {
      chips.push({ key: 'zones', label: `Zones: ${filters.zones.length} selected` });
    }
    if (filters.status && filters.status !== 'all') {
      chips.push({ key: 'status', label: `Status: ${statusLabels[filters.status] || filters.status}` });
    }
    if (filters.dateRange) {
      const dateLabel = (returnsDatePicker && returnsDatePicker.altInput && returnsDatePicker.altInput.value)
        ? returnsDatePicker.altInput.value
        : filters.dateRange;
      chips.push({ key: 'dateRange', label: `Return date: ${dateLabel}` });
    }
    if (filters.tab && filters.tab !== 'all') {
      chips.push({ key: 'tab', label: `Tab: ${statusLabels[filters.tab] || filters.tab}` });
    }
    chips.forEach((chip) => {
      const span = document.createElement('span');
      span.className = 'filter-chip';
      span.innerHTML = `${chip.label} <button type="button" aria-label="Remove filter" data-chip="${chip.key}"><i class="ri-close-line"></i></button>`;
      span.querySelector('button').addEventListener('click', () => removeReturnFilterChip(chip.key));
      chipsEl.appendChild(span);
    });
  }

  function removeReturnFilterChip(key) {
    if (key === 'search') document.getElementById('returnsSearch').value = '';
    if (key === 'zones' && returnZoneChoices) returnZoneChoices.removeActiveItems();
    if (key === 'status') document.getElementById('returnsStatusFilter').value = 'all';
    if (key === 'dateRange') {
      if (returnsDatePicker) returnsDatePicker.clear();
      else document.getElementById('returnsDateRange').value = '';
    }
    if (key === 'tab') {
      activeReturnTab = 'all';
      setActiveReturnTab('all');
    }
    applyReturnFilters();
  }

  function setActiveReturnTab(tab) {
    document.querySelectorAll('.returnFilter.nav-link').forEach((btn) => btn.classList.remove('active'));
    const tabMap = {
      all: 'tabAllReturns',
      returnAtWarehouse: 'tabAtWarehouse',
      inReturnStock: 'tabInReturnStock',
    };
    const tabEl = document.getElementById(tabMap[tab]);
    if (tabEl) tabEl.classList.add('active');
  }

  function updateReturnStatsCards(orders) {
    const zoneSet = new Set(orders.map((item) => getReturnOrderZone(item)));
    const totalEl = document.getElementById('totalReturns');
    const warehouseEl = document.getElementById('atWarehouseCount');
    const stockEl = document.getElementById('inReturnStockCount');
    const zonesEl = document.getElementById('returnZonesCount');
    if (totalEl) totalEl.textContent = orders.length;
    if (warehouseEl) warehouseEl.textContent = orders.filter((item) => item.orderStatus === 'returnAtWarehouse').length;
    if (stockEl) stockEl.textContent = orders.filter((item) => item.orderStatus === 'inReturnStock').length;
    if (zonesEl) zonesEl.textContent = zoneSet.size;
  }

  function escapeHtml(str) {
    if (str == null) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function buildShowMoreButton(kind, text) {
    const cls = kind === 'address' ? 'js-show-full-address' : 'js-show-full-text';
    const encoded = encodeURIComponent(text || '');
    return `<button type="button" class="btn btn-link btn-sm p-0 ${cls}" data-full="${encoded}">Show More</button>`;
  }

  function getZoneBadgeClass(zone) {
    let hash = 0;
    const s = zone || 'Unassigned';
    for (let i = 0; i < s.length; i++) hash = ((hash << 5) - hash) + s.charCodeAt(i);
    return `zone-badge-${Math.abs(hash) % 6}`;
  }

  function getZoneBadgeHtml(zone) {
    const label = escapeHtml(zone || 'Unassigned');
    const cls = getZoneBadgeClass(zone);
    return `<span class="zone-cell-badge ${cls}" title="${label}"><i class="ri-map-pin-2-fill"></i>${label}</span>`;
  }

  function sortReturnItems(items) {
    const sorted = [...items];
    const dir = returnSortDir === 'desc' ? -1 : 1;
    sorted.sort((a, b) => {
      let cmp = 0;
      if (returnSortField === 'zone') {
        const za = getReturnOrderZone(a);
        const zb = getReturnOrderZone(b);
        if (za === 'Unassigned' && zb !== 'Unassigned') cmp = 1;
        else if (zb === 'Unassigned' && za !== 'Unassigned') cmp = -1;
        else cmp = za.localeCompare(zb);
      } else if (returnSortField === 'orderNumber') {
        cmp = String(a.orderNumber).localeCompare(String(b.orderNumber), undefined, { numeric: true });
      } else if (returnSortField === 'date') {
        const da = getReturnDate(a)?.getTime() || 0;
        const db = getReturnDate(b)?.getTime() || 0;
        cmp = da - db;
      }
      return cmp * dir;
    });
    return sorted;
  }

  function renderReturnZoneQuickFilters() {
    /* zone pills removed — multi-select dropdown used instead */
  }

  function toggleReturnSort(field) {
    if (returnSortField === field) {
      returnSortDir = returnSortDir === 'asc' ? 'desc' : 'asc';
    } else {
      returnSortField = field;
      returnSortDir = 'asc';
    }
    applyReturnFilters();
  }

  function buildReturnOrderRow(item, prevZone) {
    const zone = getReturnOrderZone(item);
    const row = document.createElement('tr');
    if (zone !== prevZone) row.classList.add('zone-group-start');

    const returnDate = getReturnDate(item) || new Date();
    const today = new Date();
    const daysInSystem = Math.floor((today - returnDate) / (1000 * 60 * 60 * 24));
    const statusDetails = getReturnStatusDetails(item.orderStatus);

    let returnReasonDisplay = '';
    if (item.orderShipping?.orderType === 'Exchange') {
      returnReasonDisplay = `<div><strong>Exchange:</strong> ${escapeHtml(item.orderShipping.productDescription || '')} → ${escapeHtml(item.orderShipping.productDescriptionReplacement || '')}</div>`;
    } else {
      const reasonDetails = getReturnReasonDetails(item.UnavailableReason?.[0] || 'other');
      returnReasonDisplay = `<span class="badge ${reasonDetails.badgeClass} return-reason-badge">${reasonDetails.reasonText}</span>`;
    }

    const address = item.orderCustomer?.address || '';
    const shouldShowMoreAddress = address.length > 20;
    const truncatedLocation = shouldShowMoreAddress ? escapeHtml(address.substring(0, 20)) + '...' : escapeHtml(address);
    const showMoreAddressBtn = shouldShowMoreAddress
      ? buildShowMoreButton('address', address) : '';

    const rawZone = item.orderCustomer?.zone || '';
    row.innerHTML = `
      <th scope="row">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="checkAll[]" data-order-id="${item.orderNumber}" data-zone="${escapeHtml(zone)}" value="${item.orderNumber}">
        </div>
      </th>
      <td class="zone_col">${getZoneBadgeHtml(zone)}</td>
      <td class="id"><a href="/admin/order-details/${item.orderNumber}" class="fw-medium link-primary">#${item.orderNumber}</a></td>
      <td class="customer_details">
        <div>${escapeHtml(item.orderCustomer?.fullName)}</div>
        <small class="text-muted">${truncatedLocation} ${showMoreAddressBtn}</small>
      </td>
      <td class="return_reason">${returnReasonDisplay}</td>
      <td class="return_status"><span class="badge ${statusDetails.badgeClass} status-badge">${statusDetails.statusText}</span></td>
      <td class="amount_details"><div><strong>${escapeHtml(item.orderShipping?.amountType)}:</strong> ${item.orderShipping?.amount} EGP</div></td>
      <td class="return_date">${returnDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</td>
      <td class="days_in_system"><span class="${daysInSystem > 7 ? 'text-danger fw-medium' : ''}">${daysInSystem} days</span></td>
      <td>
        <div class="orders-table-dropdown">
          <button type="button" class="dropdown-toggle" data-dropdown-toggle aria-expanded="false" aria-label="Row actions"><i class="ri-more-fill"></i></button>
          <ul class="dropdown-menu">
            <li><button type="button" class="dropdown-item" onclick="updateReturnStatus('${item.orderNumber}')"><i class="ri-edit-2-fill text-warning"></i><span>Update Status</span></button></li>
            <li><button type="button" class="dropdown-item js-assign-courier" data-order-number="${escapeHtml(String(item.orderNumber))}" data-zone="${escapeHtml(rawZone)}"><i class="ri-user-add-line text-success"></i><span>Assign to Courier</span></button></li>
            <li><button type="button" class="dropdown-item" onclick="removeFromReturns('${item.orderNumber}')"><i class="ri-delete-bin-6-fill text-danger"></i><span>Remove</span></button></li>
          </ul>
        </div>
      </td>
    `;
