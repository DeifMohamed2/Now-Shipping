  function renderReturnTable(items) {
    const container = returnItemsByZone;
    const sorted = sortReturnItems(items);
    const sortIcon = (field) => {
      if (returnSortField !== field) return '<i class="ri-arrow-up-down-line sort-icon"></i>';
      return returnSortDir === 'asc'
        ? '<i class="ri-arrow-up-s-line sort-icon"></i>'
        : '<i class="ri-arrow-down-s-line sort-icon"></i>';
    };

    container.innerHTML = `
      <div class="admin-table-scroll">
        <table class="table table-nowrap table-hover align-middle admin-data-table mb-0" id="unifiedReturnTable">
          <thead class="text-muted table-light">
            <tr class="text-uppercase">
              <th scope="col" style="width:25px">
                <div class="form-check"><input class="form-check-input" type="checkbox" id="tableCheckAll" title="Select all"></div>
              </th>
              <th class="sortable-th${returnSortField === 'zone' ? ' sorted' : ''}" onclick="toggleReturnSort('zone')" style="min-width:200px">Zone ${sortIcon('zone')}</th>
              <th class="sortable-th${returnSortField === 'orderNumber' ? ' sorted' : ''}" onclick="toggleReturnSort('orderNumber')">Order ID ${sortIcon('orderNumber')}</th>
              <th>Customer & Location</th>
              <th>Return Reason</th>
              <th>Status</th>
              <th>Amount</th>
              <th class="sortable-th${returnSortField === 'date' ? ' sorted' : ''}" onclick="toggleReturnSort('date')">Return Date ${sortIcon('date')}</th>
              <th>Days</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody class="list form-check-all" id="returnTableBody"></tbody>
        </table>
      </div>
    `;

    const tbody = container.querySelector('#returnTableBody');
    let prevZone = null;
    sorted.forEach((item) => {
      const zone = getReturnOrderZone(item);
      tbody.appendChild(buildReturnOrderRow(item, prevZone));
      prevZone = zone;
    });

    const tableCheckAll = container.querySelector('#tableCheckAll');
    const globalCheckAll = document.getElementById('checkAll');
    if (tableCheckAll && globalCheckAll) {
      tableCheckAll.addEventListener('change', () => {
        globalCheckAll.checked = tableCheckAll.checked;
        globalCheckAll.indeterminate = false;
        document.querySelectorAll('input[name="checkAll[]"]').forEach((cb) => {
          cb.checked = tableCheckAll.checked;
          handleCheckboxChange(cb);
        });
      });
    }
  }

  function getFilteredReturnOrders() {
    const filters = getReturnFilterState();
    return allReturnOrders.filter((item) => {
      if (!matchesReturnSearch(item, filters.search)) return false;
      if (filters.zones.length > 0 && !filters.zones.includes(getReturnOrderZone(item))) return false;
      if (filters.status !== 'all' && item.orderStatus !== filters.status) return false;
      if (!matchesReturnDateRange(item, filters.dateRange)) return false;
      if (!matchesReturnTab(item, filters.tab)) return false;
      return true;
    });
  }

  function applyReturnFilters() {
    if (returnZoneChoices && typeof returnZoneChoices.hideDropdown === 'function') {
      returnZoneChoices.hideDropdown(true);
    }
    const filters = getReturnFilterState();
    const filtered = getFilteredReturnOrders();

    updateReturnStatsCards(allReturnOrders);
    updateReturnResultsCount(filtered.length, allReturnOrders.length);
    updateReturnFilterChips(filters);

    returnItemsByZone.innerHTML = '';
    NoResult.style.display = filtered.length === 0 ? 'block' : 'none';

    if (filtered.length > 0) {
      renderReturnTable(filtered);
    }

    inProgressReturns(filtered.filter((item) => item.orderStatus === 'returnAtWarehouse' && item.deliveryMan));
    clearSelection();
  }

  function clearReturnFilters() {
    document.getElementById('returnsSearch').value = '';
    if (returnZoneChoices) returnZoneChoices.removeActiveItems();
    document.getElementById('returnsStatusFilter').value = 'all';
    if (returnsDatePicker) returnsDatePicker.clear();
    else document.getElementById('returnsDateRange').value = '';
    activeReturnTab = 'all';
    setActiveReturnTab('all');
    applyReturnFilters();
  }

