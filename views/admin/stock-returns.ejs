  async function loadCouriersByZones(zones) {
    const zoneList = Array.isArray(zones) ? zones.filter(Boolean) : (zones ? [zones] : []);
    const params = new URLSearchParams();
    zoneList.forEach((z) => params.append('zone', z));
    const courierSelect = document.getElementById('courierSelect');
    document.getElementById('courierLoader').style.display = 'block';
    courierSelect.disabled = true;
    courierSelect.innerHTML = '<option value="">Loading couriers...</option>';

    try {
      const response = await fetch(`/admin/get-couriers-by-zone?${params.toString()}`, {
        method: 'GET',
        headers: { 'Content-Type': 'application/json' },
      });
      const couriers = await response.json();
      if (couriers && couriers.error) {
        throw new Error(couriers.error);
      }
      courierSelect.innerHTML = '<option value="">Select a courier</option>';
      (Array.isArray(couriers) ? couriers : []).forEach((courier) => {
        const option = document.createElement('option');
        option.value = courier._id;
        option.textContent = courier.name;
        courierSelect.appendChild(option);
      });
    } catch (error) {
      console.error('Error fetching couriers:', error);
      courierSelect.innerHTML = '<option value="">Failed to load couriers</option>';
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Failed to load available couriers. Please try again.',
      });
    } finally {
      courierSelect.disabled = false;
      document.getElementById('courierLoader').style.display = 'none';
    }
  }

  function getCouriers(orderNumber, zone) {
    document.getElementById('courierOrderIds').value = orderNumber;
    document.getElementById('courierZone').value = zone || '';
    showAssignCourierModal('Assign to Courier');
