  function syncReturnsGlobalCheckAll() {
    const el = document.getElementById('checkAll');
    if (!el) return;
    const boxes = document.querySelectorAll('input[name="checkAll[]"]');
    let n = 0;
    let c = 0;
    boxes.forEach((b) => {
      n++;
      if (b.checked) c++;
    });
    el.checked = n > 0 && c === n;
    el.indeterminate = c > 0 && c < n;
  }

  function syncReturnsZoneCheckAllFromRows(zone) {
    if (!zone) return;
    let zh = null;
    document.querySelectorAll('.zone-check-all').forEach((z) => {
      if (z.getAttribute('data-zone') === zone) zh = z;
    });
    if (!zh) return;
    let n = 0;
    let c = 0;
    document.querySelectorAll('input[name="checkAll[]"]').forEach((b) => {
      if (b.getAttribute('data-zone') !== zone) return;
      n++;
      if (b.checked) c++;
    });
    zh.checked = n > 0 && c === n;
    zh.indeterminate = c > 0 && c < n;
  }

  function onReturnsListCheckboxChange(e) {
    const t = e.target;
    if (!t || !t.matches || !t.matches('input.form-check-input')) return;
    if (t.id === 'checkAll') {
      document.querySelectorAll('input[name="checkAll[]"]').forEach((cb) => {
        cb.checked = t.checked;
        handleCheckboxChange(cb);
      });
      document.querySelectorAll('.zone-check-all').forEach((z) => {
        z.checked = t.checked;
        z.indeterminate = false;
      });
      return;
    }
    if (t.classList.contains('zone-check-all')) {
      const zone = t.getAttribute('data-zone');
      if (!zone) return;
      document.querySelectorAll('input[name="checkAll[]"]').forEach((cb) => {
        if (cb.getAttribute('data-zone') === zone) {
          cb.checked = t.checked;
          handleCheckboxChange(cb);
        }
      });
      t.indeterminate = false;
      syncReturnsGlobalCheckAll();
      return;
    }
    if (t.name === 'checkAll[]') {
      handleCheckboxChange(t);
      const zone = t.getAttribute('data-zone');
      if (zone) syncReturnsZoneCheckAllFromRows(zone);
      syncReturnsGlobalCheckAll();
    }
  }

  // Handle checkbox change
  function handleCheckboxChange(checkbox) {
    const orderId = checkbox.getAttribute('data-order-id');

    if (checkbox.checked) {
      if (!selectedItems.includes(orderId)) {
        selectedItems.push(orderId);
      }
    } else {
      const index = selectedItems.indexOf(orderId);
      if (index > -1) {
        selectedItems.splice(index, 1);
      }
    }

    // Update selected items count
    selectedItemsCount.textContent = selectedItems.length;

    // Show/hide bulk actions bar
    if (selectedItems.length > 0) {
      bulkActionsBar.classList.add('show');
    } else {
      bulkActionsBar.classList.remove('show');
    }
    const headerRm = document.getElementById('returns-header-remove-toolbar');
    if (headerRm) {
      headerRm.classList.toggle('d-none', selectedItems.length === 0);
      headerRm.classList.toggle('d-flex', selectedItems.length > 0);
    }
  }

  // Clear selection
  function clearSelection() {
    document.querySelectorAll('input[name="checkAll[]"]').forEach(checkbox => {
      checkbox.checked = false;
    });

    document.querySelectorAll('.zone-check-all').forEach(checkbox => {
      checkbox.checked = false;
    });

    const ca = document.getElementById('checkAll');
    if (ca) {
      ca.checked = false;
      ca.indeterminate = false;
    }

    selectedItems = [];
    selectedItemsCount.textContent = '0';
    bulkActionsBar.classList.remove('show');
    const headerRm = document.getElementById('returns-header-remove-toolbar');
    if (headerRm) {
      headerRm.classList.add('d-none');
      headerRm.classList.remove('d-flex');
    }
  }

