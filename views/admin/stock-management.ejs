              <th>Action</th>
            </tr>
          </thead>
          <tbody class="list form-check-all" id="stockTableBody"></tbody>
        </table>
      </div>
    `;

    const tbody = container.querySelector('#stockTableBody');
    let prevZone = null;
    sorted.forEach((item) => {
      const zone = getOrderZone(item);
      tbody.appendChild(buildStockOrderRow(item, prevZone));
      prevZone = zone;
    });

    const tableCheckAll = container.querySelector('#tableCheckAll');
    const globalCheckAll = document.getElementById('checkAll');
    if (tableCheckAll && globalCheckAll) {
      tableCheckAll.addEventListener('change', () => {
        globalCheckAll.checked = tableCheckAll.checked;
        globalCheckAll.indeterminate = false;
        document.querySelectorAll('input[name="checkAll[]"]').forEach((cb) => {
