  function getFilteredStockOrders() {
    const filters = getStockFilterState();
    return allStockOrders.filter((item) => {
      if (!matchesStockSearch(item, filters.search)) return false;
      if (filters.zones.length > 0 && !filters.zones.includes(getOrderZone(item))) return false;
      if (filters.status !== 'all' && item.orderStatus !== filters.status) return false;
      if (!matchesStockDateRange(item, filters.dateRange)) return false;
      if (!matchesStockTab(item, filters.tab)) return false;
      return true;
    });
  }

  function applyFilters() {
    if (stockZoneChoices && typeof stockZoneChoices.hideDropdown === 'function') {
      stockZoneChoices.hideDropdown(true);
    }
    const filters = getStockFilterState();
    const filtered = getFilteredStockOrders();

    updateStatsCards(allStockOrders);
    updateStockResultsCount(filtered.length, allStockOrders.length);
    updateStockFilterChips(filters);

    stockItemsByZone.innerHTML = '';
    NoResult.style.display = filtered.length === 0 ? 'block' : 'none';

    if (filtered.length > 0) {
      renderStockTable(filtered);
    }

    InProgressOrders(filtered.filter((item) => item.orderStatus === 'inProgress'));
    clearSelection();
  }

