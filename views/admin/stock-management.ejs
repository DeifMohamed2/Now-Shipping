      if (stockSortField !== field) return '<i class="ri-arrow-up-down-line sort-icon"></i>';
      return stockSortDir === 'asc'
        ? '<i class="ri-arrow-up-s-line sort-icon"></i>'
        : '<i class="ri-arrow-down-s-line sort-icon"></i>';
    };

    container.innerHTML = `
      <div class="admin-table-scroll">
        <table class="table table-nowrap table-hover align-middle admin-data-table mb-0" id="unifiedStockTable">
          <thead class="text-muted table-light">
            <tr class="text-uppercase">
