<%- contentFor('HeaderCss') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.7.6/lottie.min.js"></script>
<link href="/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/choices.js/public/assets/styles/choices.min.css" rel="stylesheet" type="text/css" />
<link href="/assets/libs/flatpickr/flatpickr.min.css" rel="stylesheet" type="text/css" />
<link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">

<%- contentFor('body') %>
<style>
  .dropdown-fix .dropdown-menu {
    position: fixed !important;
    z-index: 1050 !important;
  }

  .stock-page {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    max-width: 100%;
  }

  .stock-page .stats-card {
    border: 1px solid rgba(64, 81, 137, 0.08);
    border-radius: 12px;
    background: #fff;
    box-shadow: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .stock-page .stats-card:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(64, 81, 137, 0.08);
  }

  .stock-page .stats-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    flex-shrink: 0;
  }

  /* Unified main panel — one surface, section dividers only */
  .stock-panel {
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
  }

  .stock-panel__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.25rem 1.5rem 0;
  }

  .stock-panel__title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: #212529;
  }

  .stock-panel__subtitle {
    font-size: 0.8125rem;
    margin-top: 0.2rem;
  }

  .stock-quick-bar {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #eef0f4;
  }

  .stock-quick-form {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stock-quick-form .form-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #878a99;
    margin-bottom: 0.35rem;
  }

  .stock-quick-fields {
    display: flex;
    align-items: stretch;
    gap: 0.65rem;
    flex: 1 1 auto;
    min-width: min(100%, 420px);
    max-width: 520px;
  }

  .stock-quick-fields .input-group {
    flex: 1 1 auto;
    min-width: 0;
  }

  .stock-quick-fields .form-control,
  .stock-quick-fields .input-group-text {
    border-radius: 8px;
    border-color: #e9ebec;
    font-size: 0.875rem;
  }

  .stock-quick-fields .input-group .form-control {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }

  .stock-quick-fields .input-group-text {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    background: #f8f9fa;
  }

  .stock-quick-fields .btn {
    flex-shrink: 0;
    border-radius: 8px;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
    white-space: nowrap;
  }

  .stock-filter-bar {
    padding: 1rem 1.5rem 0;
  }

  .stock-filter-bar .filter-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #878a99;
    margin-bottom: 0.35rem;
  }

  .stock-filter-bar .search-box {
    position: relative;
  }

  .stock-filter-bar .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #878a99;
    pointer-events: none;
  }

  .stock-filter-bar .search-box input {
    padding-left: 2.25rem;
    border-radius: 8px;
    border-color: #e9ebec;
  }

  .stock-filter-bar .form-control,
  .stock-filter-bar .form-select {
    border-radius: 8px;
    border-color: #e9ebec;
    font-size: 0.875rem;
    min-height: 38px;
  }

  .stock-filter-actions {
    display: flex;
    gap: 0.5rem;
    height: 38px;
  }

  .stock-filter-actions .btn {
    border-radius: 8px;
    min-height: 38px;
  }

  .filter-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.85rem 1.5rem 1rem;
    border-bottom: 1px solid #eef0f4;
  }

  .filter-results-count {
    font-size: 0.8125rem;
    color: #495057;
    font-weight: 500;
  }

  .filter-results-count strong {
    color: #405189;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    flex: 1;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    background: #f3f6f9;
    border: none;
    border-radius: 999px;
    font-size: 0.75rem;
    color: #405189;
  }

  .filter-chip button {
    border: none;
    background: none;
    padding: 0;
    line-height: 1;
    color: #878a99;
    cursor: pointer;
  }

  .filter-chip button:hover {
    color: #f06548;
  }

  .stock-panel__body {
    padding: 0 1.5rem 1.25rem;
  }

  .stock-page .status-badge {
    padding: 5px 10px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .stock-page .nav-tabs-custom {
    border-bottom: 1px solid #eef0f4;
    gap: 0.15rem;
    margin: 0 -0.25rem 1rem;
  }

  .stock-page .nav-tabs-custom .nav-link {
    border: none;
    border-radius: 8px 8px 0 0;
    padding: 0.55rem 0.85rem;
    color: #878a99;
    font-weight: 500;
    font-size: 0.8125rem;
  }

  .stock-page .nav-tabs-custom .nav-link.active {
    color: #405189;
    background: transparent;
    box-shadow: inset 0 -2px 0 #405189;
  }

  .unified-stock-table-wrap {
    border: 1px solid #eef0f4;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }

  .stock-page .admin-table-scroll {
    max-height: min(68vh, 720px);
    overflow: auto;
  }

  .stock-page .admin-data-table {
    margin-bottom: 0;
  }

  .stock-page .admin-data-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #f8f9fb !important;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    border-bottom: 1px solid #e9ebec;
    padding-top: 0.65rem;
    padding-bottom: 0.65rem;
  }

  .stock-page .admin-data-table tbody tr:hover {
    background-color: rgba(64, 81, 137, 0.03);
  }

  .stock-page .bulk-actions {
    display: none;
    background: #405189;
    border-radius: 8px;
    padding: 0.65rem 1rem;
    margin-bottom: 0.85rem;
    color: #fff;
  }

  .stock-page .bulk-actions.show {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stock-page .bulk-actions-title {
    font-weight: 500;
    margin-bottom: 0;
    color: #fff;
  }

  .stock-page .bulk-actions-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .stock-subpanel {
    border-radius: 14px;
    background: #fff;
    overflow: hidden;
  }

  .stock-subpanel__header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #eef0f4;
  }

  .stock-subpanel__header .card-title {
    font-size: 1rem;
    margin: 0;
  }

  .stock-subpanel__body {
    padding: 1.25rem 1.5rem;
  }

  .zone-pills-bar {
    display: none;
  }

  .stock-filter-bar .choices {
    margin-bottom: 0;
    font-size: 0.875rem;
  }

  .stock-filter-bar .choices__inner {
    min-height: 38px;
    border-radius: 8px;
    border-color: #e9ebec;
    padding: 4px 8px;
    background: #fff;
  }

  .stock-filter-bar .choices__list--multiple .choices__item {
    background: #405189;
    border: 1px solid #405189;
    border-radius: 6px;
    font-size: 0.72rem;
    margin-bottom: 2px;
    max-width: 100%;
    white-space: normal;
    word-break: break-word;
  }

  .stock-filter-bar .choices__input {
    background: transparent;
    margin-bottom: 0;
    font-size: 0.8125rem;
  }

  .stock-filter-bar .choices__list--dropdown {
    z-index: 1060;
    border-radius: 8px;
    border-color: #e9ebec;
    max-height: 280px;
    overflow-y: auto;
    box-shadow: 0 8px 24px rgba(64, 81, 137, 0.12);
  }

  .stock-filter-bar .choices__list--dropdown .choices__item--selectable.is-highlighted {
    background: #f3f6fb;
  }

  .stock-filter-bar .choices.is-open .choices__inner {
    border-color: #405189;
    box-shadow: 0 0 0 3px rgba(64, 81, 137, 0.1);
  }

  .stock-filter-bar .choices[data-type*="select-multiple"] .choices__inner {
    min-height: 42px;
    padding: 6px 10px;
  }

  .stock-filter-bar .choices__list--dropdown .choices__item {
    font-size: 0.8125rem;
    padding: 8px 12px;
    white-space: normal;
    word-break: break-word;
  }

  .zone-cell-badge {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.3rem;
    max-width: 260px;
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.35;
    white-space: normal;
    word-break: break-word;
    text-align: left;
  }

  .zone-cell-badge i {
    flex-shrink: 0;
    font-size: 0.8rem;
  }

  .zone-badge-0 { background: #e8eeff; color: #405189; }
  .zone-badge-1 { background: #e6f4f1; color: #0ab39c; }
  .zone-badge-2 { background: #fff4e6; color: #f7b84b; }
  .zone-badge-3 { background: #fde8e4; color: #f06548; }
  .zone-badge-4 { background: #ebeff2; color: #495057; }
  .zone-badge-5 { background: #f3e8fd; color: #6559cc; }

  .stock-page .admin-data-table tbody tr.zone-group-start td {
    border-top: 2px solid rgba(64, 81, 137, 0.12);
  }

  .sortable-th {
    cursor: pointer;
    user-select: none;
  }

  .sortable-th:hover {
    color: #405189;
  }

  .sortable-th .sort-icon {
    font-size: 0.85rem;
    opacity: 0.5;
  }

  .sortable-th.sorted .sort-icon {
    opacity: 1;
    color: #405189;
  }

  @media (max-width: 767.98px) {
    .stock-panel__top,
    .stock-quick-bar,
    .stock-filter-bar,
    .filter-meta-bar,
    .stock-panel__body,
    .stock-subpanel__header,
    .stock-subpanel__body {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .stock-quick-fields {
      max-width: none;
      flex-direction: column;
      align-items: stretch;
    }

    .stock-quick-fields .btn {
      width: 100%;
    }

    .stock-filter-actions {
      height: auto;
    }
  }
</style>

<div class="stock-page">
  <!-- Stats -->
  <div class="row g-3">
    <div class="col-md-3 col-sm-6">
      <div class="card stats-card border-0">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-primary-subtle text-primary">
              <i class="ri-store-2-line fs-5"></i>
            </div>
            <div class="ms-3">
              <h6 class="mb-0 text-muted small">Total Orders</h6>
              <h4 class="mt-1 mb-0 fw-semibold" id="totalInStock">0</h4>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card stats-card border-0">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-success-subtle text-success">
              <i class="ri-archive-line fs-5"></i>
            </div>
            <div class="ms-3">
              <h6 class="mb-0 text-muted small">In Stock</h6>
              <h4 class="mt-1 mb-0 fw-semibold" id="readyForDispatch">0</h4>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card stats-card border-0">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-warning-subtle text-warning">
              <i class="ri-truck-line fs-5"></i>
            </div>
            <div class="ms-3">
              <h6 class="mb-0 text-muted small">With Courier</h6>
              <h4 class="mt-1 mb-0 fw-semibold" id="processingOrders">0</h4>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card stats-card border-0">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-info-subtle text-info">
              <i class="ri-map-pin-line fs-5"></i>
            </div>
            <div class="ms-3">
              <h6 class="mb-0 text-muted small">Zones</h6>
              <h4 class="mt-1 mb-0 fw-semibold" id="pendingArrivals">0</h4>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main panel -->
  <div class="card stock-panel border-0 shadow-sm" id="stockList">
    <div class="stock-panel__top">
      <div>
        <h5 class="stock-panel__title">Stock Management</h5>
        <p class="stock-panel__subtitle">Warehouse pickups and courier dispatch</p>
      </div>
      <div class="dropdown">
        <button type="button" class="btn btn-primary btn-sm dropdown-toggle" id="exportStockBtn" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="ri-file-download-line align-bottom me-1"></i> Export
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
          <li><button type="button" class="dropdown-item" onclick="exportStockData('excel')"><i class="ri-file-excel-2-line me-2 text-success"></i>Excel (.xls)</button></li>
          <li><button type="button" class="dropdown-item" onclick="exportStockData('csv')"><i class="ri-file-text-line me-2 text-primary"></i>CSV</button></li>
          <li><hr class="dropdown-divider"></li>
          <li><button type="button" class="dropdown-item" onclick="exportStockData('print')"><i class="ri-printer-line me-2 text-secondary"></i>Print / PDF</button></li>
        </ul>
      </div>
    </div>

    <div class="stock-quick-bar">
      <form id="quickAddForm" class="stock-quick-form">
        <div>
          <label for="orderNumber" class="form-label">Quick add to stock</label>
          <div class="stock-quick-fields">
            <div class="input-group">
              <span class="input-group-text">#</span>
              <input type="text" class="form-control" id="orderNumber" placeholder="Order number" required>
            </div>
            <button type="submit" class="btn btn-primary">
              <i class="ri-add-line me-1"></i> Add
            </button>
          </div>
        </div>
      </form>
    </div>

    <div class="stock-filter-bar">
      <form id="stockSearchForm" onsubmit="return false;">
        <div class="row g-3 align-items-end">
          <div class="col-xl-3 col-lg-4 col-md-6">
            <label class="filter-label" for="stockSearch">Search</label>
            <div class="search-box">
              <input type="text" class="form-control" id="stockSearch" placeholder="Order, product, customer, phone…">
              <i class="ri-search-line search-icon"></i>
            </div>
          </div>
          <div class="col-xl-3 col-lg-3 col-md-6">
            <label class="filter-label" for="zoneFilter">Zones</label>
            <select class="form-control" id="zoneFilter" multiple></select>
          </div>
          <div class="col-xl-2 col-lg-2 col-md-4 col-sm-6">
            <label class="filter-label" for="stockStatusFilter">Status</label>
            <select class="form-select" id="stockStatusFilter">
              <option value="all" selected>All Statuses</option>
              <option value="inStock">In Stock</option>
              <option value="inProgress">With Courier</option>
            </select>
          </div>
          <div class="col-xl-2 col-lg-2 col-md-4 col-sm-6">
            <label class="filter-label" for="stockDateRange">Exit Date</label>
            <input type="text" class="form-control" id="stockDateRange" placeholder="Date range" autocomplete="off">
          </div>
          <div class="col-xl-2 col-lg-1 col-md-4 col-sm-6">
            <label class="filter-label d-none d-md-block">&nbsp;</label>
            <div class="stock-filter-actions">
              <button type="button" class="btn btn-primary flex-grow-1" onclick="applyFilters()">
                <i class="ri-filter-3-line me-1"></i> Apply
              </button>
              <button type="button" class="btn btn-light" onclick="clearStockFilters()" title="Clear filters">
                <i class="ri-close-circle-line"></i>
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>

    <div class="filter-meta-bar">
      <span class="filter-results-count" id="stockResultsCount">Showing <strong>0</strong> of <strong>0</strong> orders</span>
      <div class="filter-chips" id="stockFilterChips"></div>
    </div>

    <div class="stock-panel__body">
      <ul class="nav nav-tabs nav-tabs-custom nav-success" role="tablist">
        <li class="nav-item">
          <button class="btn stockFilter btn-link nav-link active All py-2 px-3" type="button" id="tabAll" onClick="filterStock('all')">
            <i class="ri-store-2-fill me-1 align-bottom"></i> All Items
          </button>
        </li>
        <li class="nav-item">
          <button class="btn stockFilter btn-link nav-link py-2 px-3 ReadyForDispatch" type="button" id="tabReady" onClick="filterStock('readyForDispatch')">
            <i class="ri-takeaway-line me-1 align-bottom"></i> Ready for Dispatch
          </button>
        </li>
        <li class="nav-item">
          <button class="btn stockFilter btn-link nav-link py-2 px-3 InStock" type="button" id="tabInStock" onClick="filterStock('inStock')">
            <i class="ri-archive-line me-1 align-bottom"></i> In Stock
          </button>
        </li>
        <li class="nav-item">
          <button class="btn stockFilter btn-link nav-link py-2 px-3 WithCourier" type="button" id="tabWithCourier" onClick="filterStock('inProgress')">
            <i class="ri-truck-line me-1 align-bottom"></i> With Courier
          </button>
        </li>
      </ul>

      <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <div class="form-check mb-0">
          <input class="form-check-input" type="checkbox" id="checkAll" title="Select all visible items">
          <label class="form-check-label small text-muted mb-0" for="checkAll">Select all</label>
        </div>
      </div>

      <div id="bulkActionsBar" class="bulk-actions mb-3">
        <div class="bulk-actions-title">
          <span id="selectedItemsCount">0</span> items selected
        </div>
        <div class="bulk-actions-buttons">
          <button class="btn btn-sm btn-success" onclick="assignMultipleOrders()">
            <i class="ri-user-add-line me-1"></i> Assign to Courier
          </button>
          <button class="btn btn-sm btn-info" onclick="printMultipleLabels()">
            <i class="ri-printer-line me-1"></i> Print Labels
          </button>
          <button class="btn btn-sm btn-light" onclick="clearSelection()">
            <i class="ri-close-line me-1"></i> Clear Selection
          </button>
        </div>
      </div>

      <div id="stockItemsByZone" class="unified-stock-table-wrap"></div>

      <div class="noresult" id="NoResult" style="display: none">
        <div class="text-center py-4">
          <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#405189,secondary:#0ab39c" style="width:75px;height:75px"></lord-icon>
          <h5 class="mt-2">Sorry! No Result Found</h5>
        </div>
      </div>

      <div class="d-flex justify-content-end mt-3">
        <div class="pagination-wrap hstack gap-2">
          <a class="page-item pagination-prev disabled" href="javascript:void(0);">Previous</a>
          <ul class="pagination listjs-pagination mb-0"></ul>
          <a class="page-item pagination-next" href="javascript:void(0);">Next</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Orders in Progress -->
  <div class="card stock-subpanel border-0 shadow-sm">
    <div class="stock-subpanel__header">
      <h5 class="card-title">Orders in Progress</h5>
    </div>
    <div class="stock-subpanel__body">
      <div class="row g-3" id="inProgressOrdersCards"></div>
    </div>
  </div>
</div>

<!-- Update Stock Status Modal -->
<div class="modal fade" id="updateStockStatusModal" tabindex="-1" aria-labelledby="updateStockStatusModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="updateStockStatusModalLabel">Update Stock Status</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="updateStockStatusForm">
          <input type="hidden" id="updateOrderId" name="updateOrderId" value="">
          <div class="mb-3">
            <label for="newStockStatus" class="form-label">Stock Status</label>
            <select class="form-select" id="newStockStatus" name="newStockStatus" required>
              <option value="">Select new status</option>
              <option value="inStock">In Stock</option>
              <option value="processing">Processing</option>
              <option value="readyForDispatch">Ready for Dispatch</option>
              <option value="dispatched">Dispatched</option>
              <option value="damaged">Damaged</option>
              <option value="returned">Returned</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="statusNotes" class="form-label">Notes</label>
