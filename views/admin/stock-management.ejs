<%- contentFor('FooterJs') %>
<script src="/assets/libs/list.js/list.min.js"></script>
<script src="/assets/libs/list.pagination.js/list.pagination.min.js"></script>
<script src="/assets/libs/flatpickr/flatpickr.min.js"></script>
<script src="/assets/libs/choices.js/public/assets/scripts/choices.min.js"></script>
<script src="/assets/libs/sweetalert2/sweetalert2.min.js"></script>

<script>
  const stockItemsByZone = document.getElementById("stockItemsByZone");
  const NoResult = document.getElementById("NoResult");
  const checkAll = document.getElementById("checkAll");
  const bulkActionsBar = document.getElementById("bulkActionsBar");
  const selectedItemsCount = document.getElementById("selectedItemsCount");
  let selectedItems = [];
  let allStockOrders = [];
  let activeTab = 'all';
  let stockZoneChoices = null;
  let stockDatePicker = null;
  let stockSortField = 'zone';
  let stockSortDir = 'asc';

  // Quick Add Form Submission
  document.getElementById("quickAddForm").addEventListener("submit",async function(e) {
    e.preventDefault();
    
    const orderNumber = document.getElementById("orderNumber").value.trim();
    // const stockStatus = document.getElementById("stockStatus").value;
    // const stockNotes = document.getElementById("stockNotes").value;
    
    // Show loading indicator
    Swal.fire({
      title: 'Processing...',
      text: 'Adding order to stock',
      allowOutsideClick: false,
      didOpen: () => {
        Swal.showLoading();
      }
    });
    try {
      // post request to add order to stock
      const response = await fetch('/admin/add-to-stock', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({orderNumber})
    });
    const data = await response.json();
    console.log(data);

    if(response.ok){
      let title = 'Added to Stock';
      let text = `Order #${orderNumber} has been added to stock`;
      
      // Check if pickup was completed
      if (data.pickupCompleted && data.pickup) {
        title = 'Pickup Completed!';
        text = `Order #${orderNumber} added to stock. Pickup #${data.pickup.pickupNumber} is now fully in stock.`;
      }
      
      Swal.fire({
        icon: 'success',
        title: title,
        text: text,
        timer: 3000
      }).then(() => {
        // Reset form and refresh stock data
        document.getElementById("quickAddForm").reset();
        // focus on order number input
        document.getElementById("orderNumber").focus();
        fetchStockItems();
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Oops...',
        text: `Order #${orderNumber} ${data.error} `,
      });
    }
    } catch (error) {
      console.error("Error adding order to stock:", error);
      Swal.fire({
        icon: 'error',
        title: 'Oops...',
        text: `Error adding order to stock: ${error.message || 'Unknown error'}`,
      });
    }

  });

  // Fetch stock items from server
  async function fetchStockItems() {
    try {
      stockItemsByZone.innerHTML = `
        <div class="text-center py-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="mt-2 text-muted mb-0">Loading stock items...</p>
        </div>
      `;

      const response = await fetch('/admin/get-stock-orders');
      const stockItems = await response.json();
      if (!response.ok) {
        throw new Error(stockItems.error || 'Failed to load stock orders');
      }

      allStockOrders = Array.isArray(stockItems) ? stockItems : [];
      populateZoneFilter(allStockOrders);
      applyFilters();
    } catch (error) {
      console.error("Error fetching stock items:", error);
      stockItemsByZone.innerHTML = '';
      NoResult.style.display = "block";
      Swal.fire({
        icon: 'error',
        title: 'Oops...',
        text: `Error fetching stock items: ${error.message || 'Unknown error'}`,
      });
    }
  }

  function getOrderZone(item) {
    const zone = item.orderCustomer?.zone;
    return zone && String(zone).trim() ? String(zone).trim() : 'Unassigned';
  }

  function getStockExitDate(item) {
    const dispatchRaw = item.orderStages?.inProgress?.completedAt
      || item.orderStages?.shipping?.completedAt;
    if (dispatchRaw) return new Date(dispatchRaw);
    const intakeRaw = item.orderStages?.packed?.completedAt;
    if (intakeRaw) return new Date(intakeRaw);
    return item.createdAt ? new Date(item.createdAt) : null;
  }

  function getStockExitMeta(item) {
    const dispatched = item.orderStages?.inProgress?.completedAt
      || item.orderStages?.shipping?.completedAt;
    if (dispatched) {
      return { date: new Date(dispatched), kind: 'exit' };
    }
    const intake = item.orderStages?.packed?.completedAt;
    if (intake) {
      return { date: new Date(intake), kind: 'intake' };
    }
    return { date: item.createdAt ? new Date(item.createdAt) : null, kind: 'unknown' };
  }

  function formatStockExitCell(item) {
    const meta = getStockExitMeta(item);
    if (!meta.date || Number.isNaN(meta.date.getTime())) {
      return '<span class="text-muted">—</span>';
    }
    const formatted = meta.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    if (meta.kind === 'exit') {
      return `<div>${formatted}</div><small class="badge bg-warning-subtle text-warning">Dispatched</small>`;
    }
    if (meta.kind === 'intake') {
      return `<div>${formatted}</div><small class="badge bg-primary-subtle text-primary">In stock</small>`;
    }
    return formatted;
  }

  function getStockDateRangeValue() {
    if (stockDatePicker && stockDatePicker.selectedDates.length > 0) {
      return stockDatePicker.input.value || '';
    }
    return document.getElementById('stockDateRange')?.value || '';
  }

  function parseStockDateRange(dateRange) {
    if (!dateRange || !dateRange.trim()) return null;
    const parts = dateRange.split(/\s+to\s+/i).map((s) => s.trim()).filter(Boolean);
    const parseOne = (s) => {
      const iso = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (iso) return new Date(+iso[1], +iso[2] - 1, +iso[3]);
      const d = new Date(s);
      return Number.isNaN(d.getTime()) ? null : d;
    };
    const from = parseOne(parts[0]);
    if (!from) return null;
    from.setHours(0, 0, 0, 0);
    let to = new Date(from);
    if (parts[1]) {
      const parsedTo = parseOne(parts[1]);
      if (parsedTo) {
        to = parsedTo;
        to.setHours(23, 59, 59, 999);
      } else {
        to.setHours(23, 59, 59, 999);
      }
    } else {
      to.setHours(23, 59, 59, 999);
    }
    return { from, to };
  }

  function initStockDatePicker() {
    const el = document.getElementById('stockDateRange');
    if (!el || typeof flatpickr === 'undefined') return;
    if (stockDatePicker) {
      stockDatePicker.destroy();
      stockDatePicker = null;
    }
    stockDatePicker = flatpickr(el, {
      mode: 'range',
      dateFormat: 'Y-m-d',
      altInput: true,
      altFormat: 'd M, Y',
      disableMobile: true,
      allowInput: false,
      onChange: function () {
        clearTimeout(stockSearchDebounce);
        stockSearchDebounce = setTimeout(applyFilters, 200);
      },
      onClose: function (selectedDates) {
        if (selectedDates.length > 0) applyFilters();
      },
    });
  }

  function matchesStockSearch(item, search) {
    if (!search) return true;
    const haystack = [
      item.orderNumber,
      item.orderShipping?.productDescription,
      item.orderShipping?.productDescriptionReplacement,
      item.orderCustomer?.fullName,
      item.orderCustomer?.phoneNumber,
      item.orderCustomer?.address,
      item.orderCustomer?.zone,
      item.orderStatus,
    ].filter(Boolean).join(' ').toLowerCase();
    return haystack.includes(search);
  }

  function matchesStockDateRange(item, dateRange) {
    const range = parseStockDateRange(dateRange);
    if (!range) return true;
    const exitDate = getStockExitDate(item);
    if (!exitDate || Number.isNaN(exitDate.getTime())) return false;
    return exitDate >= range.from && exitDate <= range.to;
  }

  function matchesStockTab(item, tab) {
    if (tab === 'all') return true;
    if (tab === 'readyForDispatch' || tab === 'inStock') return item.orderStatus === 'inStock';
    if (tab === 'inProgress') return item.orderStatus === 'inProgress';
    return item.orderStatus === tab;
  }

  let stockSearchDebounce = null;

  function getSelectedStockZones() {
    const el = document.getElementById('zoneFilter');
    if (stockZoneChoices) {
      const val = stockZoneChoices.getValue(true);
      if (val) {
        const arr = Array.isArray(val) ? val : [val];
        return arr
          .map((v) => (typeof v === 'object' && v != null ? v.value : v))
          .filter(Boolean);
      }
    }
    if (el) {
      return Array.from(el.selectedOptions || []).map((o) => o.value).filter(Boolean);
    }
    return [];
  }

  function initStockZoneChoices() {
    const el = document.getElementById('zoneFilter');
    if (!el || stockZoneChoices || typeof Choices === 'undefined') return;
    stockZoneChoices = new Choices(el, {
      removeItemButton: true,
      searchEnabled: true,
      searchPlaceholderValue: 'Type to search zones...',
      placeholder: true,
      placeholderValue: 'Select zones (empty = all)',
      itemSelectText: '',
      shouldSort: false,
      position: 'bottom',
      searchResultLimit: 200,
      renderChoiceLimit: 200,
      searchFloor: 1,
      fuseOptions: { threshold: 0.3, ignoreLocation: true },
      closeDropdownOnSelect: false,
      resetScrollPosition: false,
    });

    const onZoneSelectionChange = () => {
      clearTimeout(stockZoneChoices._filterDebounce);
      stockZoneChoices._filterDebounce = setTimeout(applyFilters, 150);
    };

    el.addEventListener('addItem', onZoneSelectionChange);
    el.addEventListener('removeItem', onZoneSelectionChange);
    el.addEventListener('change', onZoneSelectionChange);
  }

  function getStockFilterState() {
    return {
      search: (document.getElementById('stockSearch')?.value || '').trim().toLowerCase(),
      zones: getSelectedStockZones(),
      status: document.getElementById('stockStatusFilter')?.value || 'all',
      dateRange: getStockDateRangeValue(),
      tab: activeTab,
    };
  }

  function populateZoneFilter(orders) {
    initStockZoneChoices();
    if (!stockZoneChoices) return;
    const selected = getSelectedStockZones();
    const counts = {};
    orders.forEach((item) => {
      const zone = getOrderZone(item);
      counts[zone] = (counts[zone] || 0) + 1;
    });
    const sortedZones = Object.keys(counts).sort((a, b) => {
      if (a === 'Unassigned') return 1;
      if (b === 'Unassigned') return -1;
      return a.localeCompare(b);
    });
    const choiceItems = sortedZones.map((zone) => ({
      value: zone,
      label: `${zone} (${counts[zone]})`,
      selected: selected.includes(zone),
      disabled: false,
    }));
    stockZoneChoices.setChoices(choiceItems, 'value', 'label', true);
  }

  function updateStockResultsCount(filteredCount, totalCount) {
    const el = document.getElementById('stockResultsCount');
    if (!el) return;
    el.innerHTML = `Showing <strong>${filteredCount}</strong> of <strong>${totalCount}</strong> orders`;
  }

  function updateStockFilterChips(filters) {
    const chipsEl = document.getElementById('stockFilterChips');
    if (!chipsEl) return;
    chipsEl.innerHTML = '';
    const chips = [];
    if (filters.search) chips.push({ key: 'search', label: `Search: ${filters.search}` });
    if (filters.zones && filters.zones.length === 1) {
      chips.push({ key: 'zones', label: `Zone: ${filters.zones[0]}` });
    } else if (filters.zones && filters.zones.length > 1) {
      chips.push({ key: 'zones', label: `Zones: ${filters.zones.length} selected` });
    }
    if (filters.status && filters.status !== 'all') {
      const statusLabel = filters.status === 'inProgress' ? 'With Courier' : 'In Stock';
      chips.push({ key: 'status', label: `Status: ${statusLabel}` });
    }
    if (filters.dateRange) {
      const dateLabel = (stockDatePicker && stockDatePicker.altInput && stockDatePicker.altInput.value)
        ? stockDatePicker.altInput.value
        : filters.dateRange;
      chips.push({ key: 'dateRange', label: `Exit date: ${dateLabel}` });
    }
    if (filters.tab && filters.tab !== 'all') {
      const tabLabels = {
        readyForDispatch: 'Ready for Dispatch',
        inStock: 'In Stock',
        inProgress: 'With Courier',
      };
      chips.push({ key: 'tab', label: `Tab: ${tabLabels[filters.tab] || filters.tab}` });
    }
    chips.forEach((chip) => {
      const span = document.createElement('span');
      span.className = 'filter-chip';
      span.innerHTML = `${chip.label} <button type="button" aria-label="Remove filter" data-chip="${chip.key}"><i class="ri-close-line"></i></button>`;
      span.querySelector('button').addEventListener('click', () => removeStockFilterChip(chip.key));
      chipsEl.appendChild(span);
    });
  }

  function removeStockFilterChip(key) {
    if (key === 'search') document.getElementById('stockSearch').value = '';
    if (key === 'zones' && stockZoneChoices) stockZoneChoices.removeActiveItems();
    if (key === 'status') document.getElementById('stockStatusFilter').value = 'all';
    if (key === 'dateRange') {
      if (stockDatePicker) stockDatePicker.clear();
      else document.getElementById('stockDateRange').value = '';
    }
    if (key === 'tab') {
      activeTab = 'all';
      setActiveStockTab('all');
    }
    applyFilters();
  }

  function setActiveStockTab(tab) {
    document.querySelectorAll('.stockFilter.nav-link').forEach((btn) => btn.classList.remove('active'));
    const tabMap = {
      all: 'tabAll',
      readyForDispatch: 'tabReady',
      inStock: 'tabInStock',
      inProgress: 'tabWithCourier',
    };
    const tabEl = document.getElementById(tabMap[tab]);
    if (tabEl) tabEl.classList.add('active');
  }

  function escapeHtml(str) {
    if (str == null) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function buildShowMoreButton(kind, text) {
    const cls = kind === 'address' ? 'js-show-full-address' : 'js-show-full-text';
    const encoded = encodeURIComponent(text || '');
    return `<button type="button" class="btn btn-link btn-sm p-0 ${cls}" data-full="${encoded}">Show More</button>`;
  }

  function getZoneBadgeClass(zone) {
    let hash = 0;
    const s = zone || 'Unassigned';
    for (let i = 0; i < s.length; i++) hash = ((hash << 5) - hash) + s.charCodeAt(i);
    return `zone-badge-${Math.abs(hash) % 6}`;
  }

  function getZoneBadgeHtml(zone) {
    const label = escapeHtml(zone || 'Unassigned');
    const cls = getZoneBadgeClass(zone);
    return `<span class="zone-cell-badge ${cls}" title="${label}"><i class="ri-map-pin-2-fill"></i>${label}</span>`;
  }

  function sortStockItems(items) {
    const sorted = [...items];
    const dir = stockSortDir === 'desc' ? -1 : 1;
    sorted.sort((a, b) => {
      let cmp = 0;
      if (stockSortField === 'zone') {
        const za = getOrderZone(a);
        const zb = getOrderZone(b);
        if (za === 'Unassigned' && zb !== 'Unassigned') cmp = 1;
        else if (zb === 'Unassigned' && za !== 'Unassigned') cmp = -1;
        else cmp = za.localeCompare(zb);
      } else if (stockSortField === 'orderNumber') {
        cmp = String(a.orderNumber).localeCompare(String(b.orderNumber), undefined, { numeric: true });
      } else if (stockSortField === 'arrival' || stockSortField === 'exit') {
        const da = getStockExitDate(a)?.getTime() || 0;
        const db = getStockExitDate(b)?.getTime() || 0;
        cmp = da - db;
      } else if (stockSortField === 'days') {
        const da = getStockExitDate(a)?.getTime() || 0;
        const db = getStockExitDate(b)?.getTime() || 0;
        cmp = da - db;
      }
      return cmp * dir;
    });
    return sorted;
  }

  function renderZoneQuickFilters() {
    /* zone pills removed — multi-select dropdown used instead */
  }

  function toggleStockSort(field) {
    if (stockSortField === field) {
      stockSortDir = stockSortDir === 'asc' ? 'desc' : 'asc';
    } else {
      stockSortField = field;
      stockSortDir = 'asc';
    }
    applyFilters();
  }

  function buildStockOrderRow(item, prevZone) {
    const zone = getOrderZone(item);
    const row = document.createElement('tr');
    if (zone !== prevZone) row.classList.add('zone-group-start');

    const exitMeta = getStockExitMeta(item);
    const referenceDate = exitMeta.date || new Date();
    const today = new Date();
    const daysInStock = Math.floor((today - referenceDate) / (1000 * 60 * 60 * 24));
    const statusDetails = getStockStatusDetails(item.orderStatus);

    const productDesc = item.orderShipping?.productDescription || '';
    const shouldShowMoreProduct = productDesc.length > 30;
    const truncatedDesc = shouldShowMoreProduct ? escapeHtml(productDesc.substring(0, 30)) + '...' : escapeHtml(productDesc);
    const showMoreProductBtn = shouldShowMoreProduct
      ? buildShowMoreButton('description', productDesc) : '';

    let replacementDesc = '';
    if (item.orderShipping?.orderType === 'Exchange' && item.orderShipping.productDescriptionReplacement) {
      const replDesc = item.orderShipping.productDescriptionReplacement;
      const shouldShowMoreRepl = replDesc.length > 30;
      const truncatedRepl = shouldShowMoreRepl ? escapeHtml(replDesc.substring(0, 30)) + '...' : escapeHtml(replDesc);
      const showMoreReplBtn = shouldShowMoreRepl
        ? buildShowMoreButton('description', replDesc) : '';
