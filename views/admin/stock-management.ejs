  // Update stats cards from full dataset
  function updateStatsCards(stockItems) {
    const zoneSet = new Set(stockItems.map((item) => getOrderZone(item)));
    document.getElementById('totalInStock').textContent = stockItems.length;
    document.getElementById('readyForDispatch').textContent = stockItems.filter((item) => item.orderStatus === 'inStock').length;
    document.getElementById('processingOrders').textContent = stockItems.filter((item) => item.orderStatus === 'inProgress').length;
    document.getElementById('pendingArrivals').textContent = zoneSet.size;
  }

  // Get stock status details (badge class and text)
  function getStockStatusDetails(status) {
    let badgeClass = '';
    let statusText = '';

    if (status === 'inStock') {
      badgeClass = 'bg-primary-subtle text-primary';
      statusText = 'In Stock';
    } else if (status === 'inProgress') {
      badgeClass = 'bg-warning-subtle text-warning';
      statusText = 'In Progress';
    } else if (status === 'processing') {
      badgeClass = 'bg-info-subtle text-info';
      statusText = 'Processing';
    } else if (status === 'readyForDispatch') {
      badgeClass = 'bg-success-subtle text-success';
      statusText = 'Ready for Dispatch';
    } else if (status === 'dispatched') {
      badgeClass = 'bg-secondary-subtle text-secondary';
      statusText = 'Dispatched';
    } else if (status === 'damaged') {
      badgeClass = 'bg-danger-subtle text-danger';
      statusText = 'Damaged';
    } else if (status === 'returned') {
      badgeClass = 'bg-danger-subtle text-danger';
      statusText = 'Returned';
    } else if (status === 'exchangePickup') {
      badgeClass = 'bg-info-subtle text-info';
      statusText = 'Exchange Pickup (legacy)';
    } else {
      badgeClass = 'bg-secondary-subtle text-secondary';
      statusText = status.charAt(0).toUpperCase() + status.slice(1);
    }

    return { badgeClass, statusText };
  }

 
 


  // Handle form submissions
  document.getElementById('updateStockStatusForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const orderId = document.getElementById('updateOrderId').value;
    const newStatus = document.getElementById('newStockStatus').value;
    const notes = document.getElementById('statusNotes').value;
    const location = document.getElementById('stockLocation').value;
    
    // Close modal
    const modal = bootstrap.Modal.getInstance(document.getElementById('updateStockStatusModal'));
    modal.hide();
    
    // Show success message
    Swal.fire({
      icon: 'success',
      title: 'Status Updated',
      text: `Order #${orderId} status updated to ${newStatus}`,
      timer: 2000
    }).then(() => {
      fetchStockItems();
    });
  });

  document.getElementById('assignToCourierForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const orderIds = document.getElementById('courierOrderIds').value;
    const courierId = document.getElementById('courierSelect').value;
    const notes = document.getElementById('dispatchNotes').value;
    const zone = document.getElementById('courierZone').value;
    
    if (!courierId) {
      Swal.fire({
        icon: 'warning',
        title: 'Select Courier',
        text: 'Please select a courier'
      });
      return;
    }

    try {
        console.log(orderIds,courierId,notes,zone);
      const response = await fetch('/admin/stock-managment/assign-courier', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          orderNumbers: orderIds.split(','),
          courierId,
          notes,
          zone
        })
      });

      const data = await response.json();
      

      if (!response.ok) {
        throw new Error('Failed to assign courier '+data.error);
      }

      // Close modal
      const modal = bootstrap.Modal.getInstance(document.getElementById('assignToCourierModal'));
      modal.hide();

      // Show success message
      const isMultiple = orderIds.includes(',');
      Swal.fire({
        icon: 'success',
        title: 'Assigned to Courier',
        text: isMultiple 
          ? `${orderIds.split(',').length} orders have been assigned to courier and marked for dispatch` 
          : `Order #${orderIds} has been assigned to courier and marked for dispatch`,
        timer: 2000
      }).then(() => {
        clearSelection();
        fetchStockItems();
      });

    } catch (error) {
        console.log(error.message);
      console.error('Error assigning courier:', error);
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Failed to assign courier. Please try again.'
      });
    }
  });


  function escapeCsvCell(value) {
    const str = value == null ? '' : String(value);
    if (/[",\n\r]/.test(str)) return `"${str.replace(/"/g, '""')}"`;
    return str;
  }

  function buildStockExportRows(orders) {
    return orders.map((item) => {
      const meta = getStockExitMeta(item);
      const exitDate = meta.date && !Number.isNaN(meta.date.getTime())
        ? meta.date.toLocaleDateString('en-GB')
        : '';
      const exitType = meta.kind === 'exit' ? 'Dispatched' : meta.kind === 'intake' ? 'In stock' : '';
      const referenceDate = meta.date || new Date();
      const daysInStock = Math.floor((new Date() - referenceDate) / (1000 * 60 * 60 * 24));
      const statusDetails = getStockStatusDetails(item.orderStatus);
      return {
        orderId: item.orderNumber,
        zone: getOrderZone(item),
        customer: item.orderCustomer?.fullName || '',
        phone: item.orderCustomer?.phoneNumber || '',
        address: item.orderCustomer?.address || '',
        product: item.orderShipping?.productDescription || '',
        type: item.orderShipping?.orderType || '',
        status: statusDetails.statusText,
        amountType: item.orderShipping?.amountType || '',
        amount: item.orderShipping?.amount ?? '',
        exitDate,
        exitType,
        daysInStock,
      };
    });
  }

  function downloadStockBlob(content, filename, mimeType) {
    const blob = new Blob([content], { type: mimeType });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    link.style.display = 'none';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  }

  function exportStockData(format) {
    const orders = getFilteredStockOrders();
    if (!orders.length) {
      Swal.fire({
        icon: 'warning',
        title: 'Nothing to export',
        text: 'No orders match your current filters.',
        confirmButtonColor: '#405189',
      });
      return;
    }

    const rows = buildStockExportRows(orders);
    const headers = [
      'Order ID', 'Zone', 'Customer', 'Phone', 'Address', 'Product', 'Type',
      'Status', 'Amount Type', 'Amount (EGP)', 'Exit Date', 'Exit Type', 'Days in Stock',
    ];
    const stamp = new Date().toISOString().slice(0, 10);
    const baseName = `stock_pickups_${stamp}_${orders.length}_orders`;

    if (format === 'csv') {
      const lines = [
        headers.map(escapeCsvCell).join(','),
        ...rows.map((r) => [
          r.orderId, r.zone, r.customer, r.phone, r.address, r.product, r.type,
          r.status, r.amountType, r.amount, r.exitDate, r.exitType, r.daysInStock,
        ].map(escapeCsvCell).join(',')),
      ];
      downloadStockBlob('\uFEFF' + lines.join('\r\n'), `${baseName}.csv`, 'text/csv;charset=utf-8');
      Swal.fire({
        icon: 'success',
        title: 'Export ready',
        text: `${orders.length} orders exported as CSV.`,
        timer: 2200,
        showConfirmButton: false,
      });
      return;
    }

    if (format === 'excel') {
      const tableRows = rows.map((r) => `
        <tr>
          <td>${escapeHtml(r.orderId)}</td>
          <td>${escapeHtml(r.zone)}</td>
          <td>${escapeHtml(r.customer)}</td>
          <td>${escapeHtml(r.phone)}</td>
          <td>${escapeHtml(r.address)}</td>
          <td>${escapeHtml(r.product)}</td>
          <td>${escapeHtml(r.type)}</td>
          <td>${escapeHtml(r.status)}</td>
          <td>${escapeHtml(r.amountType)}</td>
          <td>${escapeHtml(r.amount)}</td>
          <td>${escapeHtml(r.exitDate)}</td>
          <td>${escapeHtml(r.exitType)}</td>
          <td>${escapeHtml(r.daysInStock)}</td>
        </tr>`).join('');
      const html = `
        <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel">
        <head><meta charset="UTF-8"><title>Stock Export</title></head>
        <body>
          <table border="1">
            <thead><tr>${headers.map((h) => `<th>${escapeHtml(h)}</th>`).join('')}</tr></thead>
            <tbody>${tableRows}</tbody>
          </table>
        </body></html>`;
      downloadStockBlob(html, `${baseName}.xls`, 'application/vnd.ms-excel;charset=utf-8');
      Swal.fire({
        icon: 'success',
        title: 'Export ready',
        text: `${orders.length} orders exported for Excel.`,
        timer: 2200,
        showConfirmButton: false,
      });
      return;
    }

    if (format === 'print') {
      const printRows = rows.map((r) => `
        <tr>
          <td>#${escapeHtml(r.orderId)}</td>
          <td>${escapeHtml(r.zone)}</td>
          <td>${escapeHtml(r.customer)}</td>
          <td>${escapeHtml(r.phone)}</td>
          <td>${escapeHtml(r.product)}</td>
          <td>${escapeHtml(r.status)}</td>
          <td>${escapeHtml(r.amount)} EGP</td>
          <td>${escapeHtml(r.exitDate)}</td>
          <td>${escapeHtml(r.exitType)}</td>
          <td>${escapeHtml(r.daysInStock)}</td>
        </tr>`).join('');
      const printWin = window.open('', '_blank');
      if (!printWin) {
        Swal.fire({ icon: 'error', title: 'Popup blocked', text: 'Allow popups to print or save as PDF.' });
        return;
      }
      printWin.document.write(`
        <!DOCTYPE html><html><head><meta charset="UTF-8"><title>Stock Pickups Export</title>
        <style>
          body { font-family: Arial, sans-serif; font-size: 11px; padding: 24px; color: #111; }
          h1 { font-size: 18px; margin: 0 0 4px; }
          .meta { color: #555; margin-bottom: 16px; font-size: 12px; }
          table { width: 100%; border-collapse: collapse; }
          th, td { border: 1px solid #ccc; padding: 6px 8px; text-align: left; vertical-align: top; }
          th { background: #f3f4f6; font-size: 10px; text-transform: uppercase; }
          tr:nth-child(even) td { background: #fafafa; }
        </style></head><body>
        <h1>Stock Management — Pickups</h1>
        <div class="meta">Exported ${new Date().toLocaleString()} · ${orders.length} orders (filtered view)</div>
        <table>
          <thead><tr>
            <th>Order</th><th>Zone</th><th>Customer</th><th>Phone</th><th>Product</th>
            <th>Status</th><th>Amount</th><th>Exit Date</th><th>Type</th><th>Days</th>
          </tr></thead>
          <tbody>${printRows}</tbody>
        </table>
        </body></html>`);
      printWin.document.close();
      printWin.focus();
      setTimeout(() => { printWin.print(); }, 350);
    }
  }

  // Fetch stock items on page load
  document.addEventListener("DOMContentLoaded", () => {
    initStockDatePicker();
    initStockZoneChoices();
    fetchStockItems();

    function handleStockAssignCourierClick(assignBtn, e) {
      e.preventDefault();
      const menu = assignBtn.closest('.dropdown-menu');
      const dropdown = assignBtn.closest('.orders-table-dropdown') || (menu && menu._adminDropdownOwner);
      if (dropdown && window.AdminTableDropdowns) {
        AdminTableDropdowns.close(dropdown);
      }
      getCouriers(
        assignBtn.getAttribute('data-order-number') || '',
        assignBtn.getAttribute('data-zone') || ''
      );
    }

    // Portaled row menus live outside #stockList — handle assign at document level
    document.addEventListener('click', (e) => {
      const assignBtn = e.target.closest('.js-assign-courier');
      if (!assignBtn || !document.getElementById('stockList')) return;
      handleStockAssignCourierClick(assignBtn, e);
    }, true);

    document.getElementById('stockList').addEventListener('click', (e) => {
      const textBtn = e.target.closest('.js-show-full-text');
      if (textBtn) {
        e.preventDefault();
        showFullDescription(decodeURIComponent(textBtn.getAttribute('data-full') || ''));
        return;
      }
      const addrBtn = e.target.closest('.js-show-full-address');
      if (addrBtn) {
        e.preventDefault();
        showFullAddress(decodeURIComponent(addrBtn.getAttribute('data-full') || ''));
      }
    });

    const stockSearchInput = document.getElementById('stockSearch');
    if (stockSearchInput) {
      stockSearchInput.addEventListener('input', () => {
        clearTimeout(stockSearchDebounce);
        stockSearchDebounce = setTimeout(applyFilters, 300);
      });
    }

    const statusFilter = document.getElementById('stockStatusFilter');
    if (statusFilter) statusFilter.addEventListener('change', applyFilters);
  });
</script>