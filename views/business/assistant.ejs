<%- contentFor('HeaderCss') %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" />
<link rel="stylesheet" href="/assets/rCSS/ainow-page.css" />
<% if ((typeof direction !== 'undefined' && direction === 'rtl') || (typeof currentLang !== 'undefined' && currentLang === 'ar')) { %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
<% } %>

<%- contentFor('body') %>
<% var Ap = (typeof translation !== 'undefined' && translation.business && translation.business.pages && translation.business.pages.assistant) ? translation.business.pages.assistant : {}; %>

<div class="ainow-page">
  <!-- Hero -->
  <section class="ainow-page__hero" aria-labelledby="ainow-page-title">
    <div class="ainow-page__hero-inner">
      <div class="ainow-page__hero-copy">
        <span class="ainow-page__badge">
          <i class="ri-sparkling-2-fill" aria-hidden="true"></i>
          <%= Ap.heroBadge || 'Smart Assistant' %>
        </span>
        <h1 id="ainow-page-title"><%= Ap.heroTitle || 'Create orders with natural language' %></h1>
        <p class="ainow-page__hero-lead">
          <%= Ap.heroLead || 'Talk or type in Arabic or English. AINOW collects missing details step by step and shows a preview before you confirm.' %>
        </p>
        <div class="ainow-page__hero-actions">
          <button type="button" class="ainow-page__btn-primary" id="ainow-page-hero-open">
            <i class="ri-chat-3-line" aria-hidden="true"></i>
            <%= Ap.openAssistant || 'Open AINOW' %>
          </button>
          <span class="ainow-page__btn-ghost">
            <i class="ri-global-line" aria-hidden="true"></i>
            <%= Ap.heroLanguages || 'Arabic & English' %>
          </span>
        </div>
      </div>
      <div class="ainow-page__hero-visual" aria-hidden="true">
        <div class="ainow-page__hero-mock">
          <div class="ainow-page__mock-header">
            <span class="ainow-page__mock-dot"></span>
            <span class="ainow-page__mock-title">AINOW</span>
          </div>
          <div class="ainow-page__mock-bubble ainow-page__mock-bubble--user" dir="auto">
            <%= Ap.mockUser || 'Create an order to Maadi…' %>
          </div>
          <div class="ainow-page__mock-bubble ainow-page__mock-bubble--bot" dir="auto">
            <%= Ap.mockBot || 'Got it. What is the customer phone number?' %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Workflow -->
  <div class="ainow-page__workflow" role="list">
    <article class="ainow-page__step" role="listitem">
      <span class="ainow-page__step-num">1</span>
      <h3><%= Ap.step1Title || 'Describe your order' %></h3>
      <p><%= Ap.step1Desc || 'Use voice or text — names, phone, area, product, and delivery preferences.' %></p>
    </article>
    <article class="ainow-page__step" role="listitem">
      <span class="ainow-page__step-num">2</span>
      <h3><%= Ap.step2Title || 'Review the preview' %></h3>
      <p><%= Ap.step2Desc || 'AINOW fills in missing fields and shows fees before anything is submitted.' %></p>
    </article>
    <article class="ainow-page__step" role="listitem">
      <span class="ainow-page__step-num">3</span>
      <h3><%= Ap.step3Title || 'Confirm in one tap' %></h3>
      <p><%= Ap.step3Desc || 'Approve the draft or edit manually — you stay in control.' %></p>
    </article>
  </div>

  <div class="row g-0">
    <div class="col-12 col-lg-8 pe-lg-3">
      <!-- Quick prompts -->
      <div class="ainow-page__card">
        <div class="ainow-page__card-head">
          <h2><i class="ri-lightbulb-flash-line" aria-hidden="true"></i> <%= Ap.cardPrompts || 'Try these prompts' %></h2>
          <button type="button" class="ainow-page__btn-primary" id="ainow-page-open-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">
            <i class="ri-chat-3-line" aria-hidden="true"></i>
            <%= Ap.openAssistant || 'Open AINOW' %>
          </button>
        </div>
        <div class="ainow-page__card-body">
          <p class="text-muted small mb-3"><%= Ap.promptsHint || 'Click a prompt to open AINOW with the text ready to send or edit.' %></p>
          <div class="ainow-page__prompts">
            <button type="button" class="ainow-page__prompt" data-ainow-prompt="<%= Ap.promptOrderAr || 'اعمل اوردر رايح للمعادي باسم محمد احمد رقم ٠١١٢٣٤٥٦٧٨ عنوان ١ شارع ٩ توصيل سريع' %>">
              <span class="ainow-page__prompt-icon"><i class="ri-shopping-bag-3-line" aria-hidden="true"></i></span>
              <span class="ainow-page__prompt-text">
                <span class="ainow-page__prompt-label"><%= Ap.promptOrderLabel || 'New delivery order' %></span>
                <span class="ainow-page__prompt-value" dir="rtl"><%= Ap.promptOrderAr || 'اعمل اوردر رايح للمعادي باسم محمد احمد رقم ٠١١٢٣٤٥٦٧٨ عنوان ١ شارع ٩ توصيل سريع' %></span>
              </span>
            </button>
            <button type="button" class="ainow-page__prompt" data-ainow-prompt="<%= Ap.promptStatusEn || 'Where is order 12345?' %>">
              <span class="ainow-page__prompt-icon"><i class="ri-search-line" aria-hidden="true"></i></span>
              <span class="ainow-page__prompt-text">
                <span class="ainow-page__prompt-label"><%= Ap.promptStatusLabel || 'Track an order' %></span>
                <span class="ainow-page__prompt-value"><%= Ap.promptStatusEn || 'Where is order 12345?' %></span>
              </span>
            </button>
            <button type="button" class="ainow-page__prompt" data-ainow-prompt="<%= Ap.promptWalletEn || 'What is my wallet balance?' %>">
              <span class="ainow-page__prompt-icon"><i class="ri-wallet-3-line" aria-hidden="true"></i></span>
              <span class="ainow-page__prompt-text">
                <span class="ainow-page__prompt-label"><%= Ap.promptWalletLabel || 'Check balance' %></span>
                <span class="ainow-page__prompt-value"><%= Ap.promptWalletEn || 'What is my wallet balance?' %></span>
              </span>
            </button>
            <button type="button" class="ainow-page__prompt" data-ainow-prompt="<%= Ap.promptPickupAr || 'عايز أجدول استلام ١٠ أوردرات بكرة' %>">
              <span class="ainow-page__prompt-icon"><i class="ri-truck-line" aria-hidden="true"></i></span>
              <span class="ainow-page__prompt-text">
                <span class="ainow-page__prompt-label"><%= Ap.promptPickupLabel || 'Schedule pickup' %></span>
                <span class="ainow-page__prompt-value" dir="rtl"><%= Ap.promptPickupAr || 'عايز أجدول استلام ١٠ أوردرات بكرة' %></span>
              </span>
            </button>
          </div>
        </div>
      </div>

      <!-- Capabilities -->
      <div class="ainow-page__card">
        <div class="ainow-page__card-head">
          <h2><i class="ri-apps-2-line" aria-hidden="true"></i> <%= Ap.cardCapabilities || 'What AINOW can do' %></h2>
        </div>
        <div class="ainow-page__card-body">
          <div class="ainow-page__features">
            <div class="ainow-page__feature">
              <i class="ri-mic-line" aria-hidden="true"></i>
              <h4><%= Ap.featVoice || 'Voice & text' %></h4>
              <p><%= Ap.featVoiceDesc || 'Push-to-talk or type — Egyptian Arabic and English supported.' %></p>
            </div>
            <div class="ainow-page__feature">
              <i class="ri-file-list-3-line" aria-hidden="true"></i>
              <h4><%= Ap.featOrders || 'Smart order drafts' %></h4>
              <p><%= Ap.featOrdersDesc || 'Structured extraction with step-by-step clarification.' %></p>
            </div>
            <div class="ainow-page__feature">
              <i class="ri-eye-line" aria-hidden="true"></i>
              <h4><%= Ap.featPreview || 'Preview before confirm' %></h4>
              <p><%= Ap.featPreviewDesc || 'See fees, COD, and delivery speed before submitting.' %></p>
            </div>
            <div class="ainow-page__feature">
              <i class="ri-map-pin-2-line" aria-hidden="true"></i>
              <h4><%= Ap.featZones || 'Egypt zone matching' %></h4>
              <p><%= Ap.featZonesDesc || 'Accurate Cairo, Giza, and Qalyubia area resolution.' %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4 ps-lg-1">
      <!-- Settings -->
      <div class="ainow-page__card">
        <div class="ainow-page__card-head">
          <h2><i class="ri-settings-3-line" aria-hidden="true"></i> <%= Ap.cardSettings || 'AINOW Settings' %></h2>
        </div>
        <div class="ainow-page__card-body">
          <form id="assistant-preferences-form">
            <div class="ainow-page__settings-item">
              <div class="ainow-page__settings-copy">
                <strong><%= Ap.enableLabel || 'Enable AINOW' %></strong>
                <span><%= Ap.enableDesc || 'Show the floating assistant button across your dashboard.' %></span>
              </div>
              <input class="form-check-input" type="checkbox" id="assistant-enabled" checked role="switch" aria-label="<%= Ap.enableLabel || 'Enable AINOW' %>">
            </div>
            <div class="ainow-page__settings-item">
              <div class="ainow-page__settings-copy">
                <strong><%= Ap.suggestionsLabel || 'Show suggestions' %></strong>
                <span><%= Ap.suggestionsDesc || 'Display quick-reply chips during order collection.' %></span>
              </div>
              <input class="form-check-input" type="checkbox" id="assistant-suggestions" checked role="switch" aria-label="<%= Ap.suggestionsLabel || 'Show suggestions' %>">
            </div>
            <div class="ainow-page__settings-item">
              <div class="ainow-page__settings-copy">
                <strong><%= Ap.autoOpenLabel || 'Auto-open on dashboard' %></strong>
                <span><%= Ap.autoOpenDesc || 'Open AINOW automatically when you visit the home page.' %></span>
              </div>
              <input class="form-check-input" type="checkbox" id="assistant-auto-open" role="switch" aria-label="<%= Ap.autoOpenLabel || 'Auto-open on dashboard' %>">
            </div>
          </form>
        </div>
      </div>

      <!-- Tip -->
      <div class="ainow-page__card">
        <div class="ainow-page__card-body">
          <div class="ainow-page__tip">
            <i class="ri-information-line" aria-hidden="true"></i>
            <p><%= Ap.accessTip || 'AINOW is available from any page via the floating button in the bottom corner — you do not need to stay on this page.' %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- contentFor('FooterJs') %>
<script src="/assets/rJS/business/ainow-page.js" defer></script>
